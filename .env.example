# Copy to .env for local work. In CI these come from repository variables.
# Nothing here is secret. Secrets (BLOCKLIST, GH_READ_TOKEN) live only in CI settings.
SITE_URL=http://localhost:4321
BASE_PATH=/
DEPLOY_TARGET=github-pages        # github-pages | cloudflare
ANALYTICS_TOOL=none               # plausible | umami | none
ANALYTICS_SRC=
ANALYTICS_DOMAIN=
