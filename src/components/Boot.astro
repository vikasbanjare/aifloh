---
// Home intro, after anfalova.art's pixel-boot idea, made original: a grid of lime / cobalt / grey tiles,
// a status line, a percent counter and a pixel "V" that assemble, then the tiles fly off to reveal the page.
// Rules kept: about 1.5 s, skippable (click, tap, Esc), off for prefers-reduced-motion, never shown without
// JavaScript (the overlay only exists while <html> has the boot class), removed from the DOM when done,
// no storage. The page underneath is fully rendered the whole time.
const COLS = 12;
const ROWS = 7;
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const tiles = Array.from({ length: COLS * ROWS }, (_, i) => {
  const r = rnd();
  const tone = r < 0.1 ? 'bt-a' : r < 0.17 ? 'bt-b' : r < 0.45 ? 'bt-2' : r < 0.75 ? 'bt-1' : 'bt-0';
  return { tone, order: Math.floor(rnd() * 24), blink: Math.floor(rnd() * 5), delay: Math.floor(rnd() * 5), i };
});

---
<div class="boot" aria-hidden="true" data-boot>
  <div class="boot-grid">
    {tiles.map((t) => <i class={`bt ${t.tone} o${t.order} b${t.blink} d${t.delay}`} />)}
  </div>
  <div class="boot-center">
    <svg class="boot-fig" viewBox="0 0 300 96" aria-hidden="true">
      <path class="bf-hand" pathLength="1" d="M8 62 C 16 40, 24 78, 34 64 S 42 40, 54 52 C 62 60, 58 72, 50 68 C 44 64, 52 48, 66 52 S 82 76, 94 62 S 108 36, 122 50 S 140 66, 150 50" />
      <path class="bf-machine" pathLength="1" d="M150 50 L170 50 L170 30 L200 30 L200 70 L230 70 L230 40 L260 40 L260 60 L292 60" />
    </svg>
    <div class="boot-head">
      <p class="boot-labels"><span class="boot-status">Drawing by hand…</span><span class="boot-pct">0%</span></p>
      <p class="boot-bar"><i class="boot-fill" /></p>
    </div>
    <p class="boot-skip">Tap to skip</p>
  </div>
</div>

<!-- The before-first-paint switch lives in Base.astro's <head> (intro prop), so the CSP can hash it. -->

<script>
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-boot]');
  if (el && root.classList.contains('booting')) {
    const pct = el.querySelector<HTMLElement>('.boot-pct')!;
    const fill = el.querySelector<HTMLElement>('.boot-fill')!;
    const status = el.querySelector<HTMLElement>('.boot-status')!;
    const lines = ['Drawing by hand…', 'Finishing by machine…', 'Ready.'];
    const DURATION = 1400;
    const start = performance.now();
    let done = false;
    let raf = 0;

    const finish = () => {
      if (done) return;
      done = true;
      cancelAnimationFrame(raf);
      el.classList.add('boot-out');
      root.classList.remove('booting');
      setTimeout(() => el.remove(), 750);
    };
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / DURATION);
      const eased = 1 - Math.pow(1 - t, 2.2);
      const p = Math.round(eased * 100);
      pct.textContent = `${p}%`;
      fill.style.transform = `scaleX(${eased})`;
      // In step with the drawing: hand until ~0.55 s, machine until ~1.3 s, then ready.
      status.textContent = lines[now - start < 770 ? 0 : t < 1 ? 1 : 2];
      if (t < 1) raf = requestAnimationFrame(step);
      else setTimeout(finish, 180);
    };
    raf = requestAnimationFrame(step);
    el.addEventListener('pointerdown', finish, { once: true });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ') finish(); }, { once: true });
    setTimeout(finish, 3000); // hard cap, whatever happens
  }
</script>

<style>
  /* Per-tile timing as classes, not style attributes, so the page passes a strict CSP. */
  .boot-grid { --cols: 12; }
  .o0 { --o: 0; } .o1 { --o: 1; } .o2 { --o: 2; } .o3 { --o: 3; } .o4 { --o: 4; } .o5 { --o: 5; } .o6 { --o: 6; } .o7 { --o: 7; } .o8 { --o: 8; } .o9 { --o: 9; } .o10 { --o: 10; } .o11 { --o: 11; } .o12 { --o: 12; } .o13 { --o: 13; } .o14 { --o: 14; } .o15 { --o: 15; } .o16 { --o: 16; } .o17 { --o: 17; } .o18 { --o: 18; } .o19 { --o: 19; } .o20 { --o: 20; } .o21 { --o: 21; } .o22 { --o: 22; } .o23 { --o: 23; }
  .b0 { --blink: 2.0s; } .b1 { --blink: 2.7s; } .b2 { --blink: 3.4s; } .b3 { --blink: 4.1s; } .b4 { --blink: 4.8s; }
  .d0 { --delay: -0.0s; } .d1 { --delay: -0.8s; } .d2 { --delay: -1.6s; } .d3 { --delay: -2.4s; } .d4 { --delay: -3.2s; }
  .boot { display: none; }
  :global(html.booting) { overflow: hidden; }
  :global(html.booting) .boot,
  .boot.boot-out {
    display: grid; position: fixed; inset: 0; z-index: 200; place-items: center; background: var(--color-bg); cursor: pointer;
  }
  .boot-grid { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(var(--cols), 1fr); grid-auto-rows: 1fr; }
  .bt { display: block; animation: blink var(--blink) steps(1) var(--delay) infinite; transition: transform 520ms var(--ease-exit), opacity 520ms var(--ease-exit); transition-delay: calc(var(--o) * 14ms); }
  .bt-0 { background: transparent; }
  .bt-1 { background: #e9e9e3; }
  .bt-2 { background: #dcdcd5; }
  .bt-a { background: var(--color-a-fill); }
  .bt-b { background: var(--color-b); }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.55; } }

  .boot-center { position: relative; display: grid; justify-items: center; gap: var(--space-6); padding: var(--space-8) var(--space-8); border-radius: var(--radius-glass); background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1px solid var(--glass-edge); box-shadow: var(--glass-shadow); transition: transform 420ms var(--ease-exit), opacity 420ms var(--ease-exit); }
  .boot-fig { width: min(300px, 70vw); height: auto; overflow: visible; }
  .bf-hand, .bf-machine { fill: none; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .bf-hand { stroke: var(--color-a-fill); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; animation: bf-draw 650ms cubic-bezier(0.45, 0, 0.2, 1) 120ms forwards; }
  .bf-machine { stroke: var(--color-b); stroke-width: 2.5; animation: bf-draw 520ms linear 760ms forwards; }
  @keyframes bf-draw { to { stroke-dashoffset: 0; } }
  .boot-head { width: min(280px, 70vw); }
  .boot-labels { display: flex; justify-content: space-between; gap: var(--space-4); margin: 0 0 var(--space-2); max-width: none; font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.06em; }
  .boot-pct { font-variant-numeric: tabular-nums; color: var(--color-b); }
  .boot-bar { height: 6px; margin: 0; max-width: none; border-radius: 99px; background: rgba(20, 20, 20, 0.1); overflow: hidden; }
  .boot-fill { display: block; height: 100%; background: var(--color-a-fill); transform: scaleX(0); transform-origin: left; }
  .boot-skip { margin: 0; font-size: var(--text-xs); color: var(--color-text-muted); }

  /* Exit: tiles fly off in a scattered order, the card drops away. */
  .boot.boot-out { pointer-events: none; background: transparent; }
  .boot.boot-out .bt { transform: translateY(-110%) scale(0.6); opacity: 0; animation: none; }
  .boot.boot-out .boot-center { transform: translateY(24px) scale(0.96); opacity: 0; }
</style>
