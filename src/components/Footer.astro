---
import { href } from '../lib/href';
import { SOCIALS, GITHUB_URL, BEHANCE_URL } from '../lib/config';
const explore = [
  { path: '/free/', label: 'Free' },
  { path: '/library/', label: 'Library' },
  { path: '/lab/', label: 'Lab' },
  { path: '/code/', label: 'Code' },
  { path: '/skills/', label: 'Skills' },
  { path: '/prompts/image/', label: 'Image prompts' },
  { path: '/prompts/video/', label: 'Video prompts' },
];
const isHome = Astro.url.pathname === import.meta.env.BASE_URL || Astro.url.pathname === import.meta.env.BASE_URL + '/';
const ctaId = isHome ? 'home-talk' : 'nav-talk';
const company = [
  { path: '/studio/', label: 'Studio' },
  { path: '/tools/', label: 'Tools' },
  { path: '/work/', label: 'Work' },
  { path: '/about/', label: 'About' },
  { path: '/contact/', label: 'Contact' },
];
---
<footer class="site-footer">
  <div class="wrap">
    <a class="big-cta" href={href('/contact/')} data-track="CTA Click" data-track-id={ctaId}>
      <span class="muted">Have something that needs doing?</span>
      <span class="big-cta-line">Let's talk <span class="arrow" aria-hidden="true">→</span></span>
    </a>
    <div class="cols">
      <nav aria-label="Explore"><h2>Explore</h2><ul role="list">{explore.map((s) => <li><a href={href(s.path)}>{s.label}</a></li>)}</ul></nav>
      <nav aria-label="Company"><h2>Company</h2><ul role="list">{company.map((s) => <li><a href={href(s.path)}>{s.label}</a></li>)}</ul></nav>
      <section aria-labelledby="f-follow">
        <h2 id="f-follow">Follow</h2>
        <ul role="list">
          {SOCIALS.map((s) => s.url ? (
            <li><a href={s.url} rel="me noopener" data-track="Follow Click" data-track-platform={s.platform}>{s.label}</a></li>
          ) : (
            <li><span class="off">{s.label}</span> <span class="stand-in">Stand-in</span></li>
          ))}
          <li><a href={GITHUB_URL} rel="me noopener">GitHub</a></li>
          <li><a href={BEHANCE_URL} rel="me noopener">Behance</a></li>
        </ul>
      </section>
      <section aria-labelledby="f-email">
        <h2 id="f-email">New drops by email</h2>
        <p class="small muted">One email when something new and free goes up. <span class="stand-in">Needs backend</span></p>
      </section>
    </div>
    <div class="base">
      <a href={href('/privacy/')}>Anonymous visit counts. No cookies.</a>
      <span class="muted">© 2026 Vikas Banjare · AI-Floh</span>
    </div>
  </div>
  <p class="wordmark" aria-hidden="true">vikas<em class="ws">banjare</em></p>
</footer>
<style>
  .site-footer { margin-top: var(--space-16); border-top: 1px solid var(--color-line); padding-top: var(--space-16); overflow: hidden; font-size: var(--text-sm); }
  .big-cta { display: grid; gap: var(--space-2); text-decoration: none; padding-bottom: var(--space-12); border-bottom: 1px solid var(--color-line); }
  .big-cta-line { font-size: var(--text-hero); font-weight: 800; letter-spacing: -0.045em; line-height: 1; }
  .big-cta .arrow { display: inline-block; color: var(--color-b); transition: transform var(--dur-base) var(--ease-standard); }
  @media (hover: hover) { .big-cta:hover .arrow { transform: translateX(0.15em); } }
  .cols { display: grid; gap: var(--space-8); padding-block: var(--space-12); grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 56rem) { .cols { grid-template-columns: repeat(4, 1fr); } }
  h2 { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.14em; color: var(--color-text-muted); font-weight: 700; margin-bottom: var(--space-3); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { min-height: 36px; display: flex; align-items: center; gap: var(--space-2); }
  li a { text-decoration: none; min-height: 36px; display: inline-flex; align-items: center; }
  @media (hover: hover) { li a:hover { color: var(--color-b); } }
  .off { color: var(--color-text-muted); }
  .small { font-size: var(--text-sm); }
  .base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); padding-block: var(--space-6); border-top: 1px solid var(--color-line); }
  .base a { min-height: 44px; display: inline-flex; align-items: center; }
  .wordmark {
    margin: 0; max-width: none; padding-inline: var(--gutter);
    font-size: var(--text-giant); font-weight: 850; letter-spacing: -0.065em; line-height: 0.78;
    color: var(--color-text); white-space: nowrap; user-select: none; transform: translateY(0.12em);
  }
  .ws { font-family: var(--font-serif); font-weight: 400; letter-spacing: -0.03em; color: var(--color-b); }
</style>
