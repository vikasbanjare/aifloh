---
// After the first copy only: "Where did you see this?" (six chips, no text field) and one soft email ask.
import { SOCIALS } from '../lib/config';
---
<aside class="after-copy" hidden aria-label="Quick question">
  <p class="ac-q">Nice. Where did you see this?</p>
  <div class="ac-chips">
    {SOCIALS.map((s) => <button type="button" class="btn ac-chip" data-track="Source Chip" data-track-platform={s.platform}>{s.label}</button>)}
  </div>
  <p class="ac-thanks muted" hidden role="status">Thanks, that helps.</p>
  <p class="ac-email muted"><span class="stand-in">Needs backend</span> Want new drops by email? Sign-up arrives soon. Everything here works without it.</p>
</aside>
<script>
  let shown = false;
  document.addEventListener('aifloh:copied', () => {
    if (shown) return;
    shown = true;
    document.querySelectorAll<HTMLElement>('.after-copy').forEach((el) => (el.hidden = false));
  });
  document.querySelectorAll<HTMLElement>('.after-copy').forEach((box) => {
    box.querySelectorAll('.ac-chip').forEach((chip) =>
      chip.addEventListener('click', () => {
        box.querySelector<HTMLElement>('.ac-chips')!.hidden = true;
        box.querySelector<HTMLElement>('.ac-thanks')!.hidden = false;
      }),
    );
  });
</script>
<style>
  .after-copy { margin: var(--space-6) 0; padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius); background: var(--color-surface); }
  .ac-q { font-weight: 700; margin-bottom: var(--space-2); }
  .ac-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .ac-email { font-size: var(--text-sm); margin: var(--space-3) 0 0; }
</style>
