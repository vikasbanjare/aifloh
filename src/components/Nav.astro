---
import { href } from '../lib/href';

interface Props {
  current?: string;
}
const { current = '' } = Astro.props;

// Play stays hidden until /play exists (Step 12).
const SHOW_PLAY = false;

const links = [
  { path: '/work', label: 'Work' },
  { path: '/tools', label: 'Tools' },
  ...(SHOW_PLAY ? [{ path: '/play', label: 'Play' }] : []),
  { path: '/studio', label: 'Studio' },
  { path: '/about', label: 'About' },
];
const isCurrent = (p: string) => current === p || current.startsWith(`${p}/`);
---

<header class="site-header">
  <nav class="wrap nav" aria-label="Main">
    <a class="brand" href={href('/')} aria-current={current === '/' ? 'page' : undefined}>AI-Floh</a>
    <ul class="nav-list" role="list">
      <li>
        <a class="nav-free press" href={href('/free')} aria-current={isCurrent('/free') ? 'page' : undefined}>Free</a>
      </li>
      {
        links.map((l) => (
          <li>
            <a class="nav-link" href={href(l.path)} aria-current={isCurrent(l.path) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="nav-talk press" href={href('/contact')} data-track="CTA Click" data-track-id="nav-talk">Let's talk</a>
      </li>
      <li>
        <a class="nav-search" href={href('/library')} aria-label="Search everything">
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg);
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
  }
  .brand {
    font-weight: 800;
    text-decoration: none;
    margin-inline-end: auto;
    min-height: var(--target-min);
    display: inline-flex;
    align-items: center;
  }
  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }
  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: var(--target-min);
    padding-inline: var(--space-1);
    text-decoration: none;
  }
  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .nav-free {
    background: var(--color-highlight);
    color: var(--color-on-highlight);
    font-weight: 700;
    border-radius: var(--radius);
    padding-inline: var(--space-3) !important;
  }
  .nav-talk {
    font-weight: 700;
    text-decoration: underline !important;
  }
  @media (hover: hover) {
    .nav-link:hover {
      text-decoration: underline;
    }
  }
</style>
