---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';
import { href } from '../lib/href';
const P = JSON.parse(readFileSync(join(process.cwd(), 'content/portfolio.json'), 'utf8'));
---
<Base title="About" description="I'm Vikas Banjare, founder of AI-Floh. 8+ years and 1000+ projects in video, motion, design, UI/UX and content.">
  <PageHead kicker="About" title="I'm Vikas Banjare, or Bubu." />
  <section class="wrap section about">
    <figure class="me">
      <img src={href(P.profile.photo)} alt={P.profile.name} width="230" height="230" />
      <figcaption class="label">Fig. 1 · {P.profile.nickname}</figcaption>
    </figure>
    <div class="txt">
      <p class="big">8+ years. 1000+ projects across video, motion graphics, brand design, UI/UX and content strategy.</p>
      <p>I started AI-Floh to keep the craft and automate the grind. I post the prompts, Claude skills and tools I use, plus the experiments that failed. Posts end with a word you can type here to get the thing itself.</p>
      <p class="key label"><i class="k k-a" aria-hidden="true"></i>Lime: made by hand <i class="k k-b" aria-hidden="true"></i>Blue: AI or automated</p>
      <p class="links">
        <a class="btn btn-primary" href={href('/contact/')} data-track="CTA Click" data-track-id="about-talk">Say hello <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn" href={P.profile.behance} rel="me noopener">Behance <span aria-hidden="true">↗</span></a>
        <a class="btn" href={P.profile.linkedin} rel="me noopener">LinkedIn <span aria-hidden="true">↗</span></a>
      </p>
    </div>
  </section>
</Base>
<style>
  .about { display: grid; gap: var(--space-12); }
  @media (min-width: 56rem) { .about { grid-template-columns: 16rem minmax(0, 1fr); align-items: start; } }
  .me { margin: 0; max-width: 16rem; border: 1px solid var(--color-text); background: var(--color-surface); transform: rotate(-2deg); box-shadow: 6px 6px 0 var(--color-text); }
  .me img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
  .me figcaption { padding: var(--space-2) var(--space-3); border-top: 1px solid var(--color-text); }
  .big { font-size: var(--t-row-sm); font-weight: 750; letter-spacing: -0.03em; line-height: 1.15; max-width: 26ch; }
  .key { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); margin-top: var(--space-6); }
  .k { display: inline-block; width: 0.9em; height: 0.9em; border: 1px solid var(--color-text); }
  .k-a { background: var(--color-a-fill); } .k-b { background: var(--color-b); margin-left: var(--space-3); }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-8); }
</style>
