---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';
const P = JSON.parse(readFileSync(join(process.cwd(), 'content/portfolio.json'), 'utf8'));
---
<Base title="Contact" description="Tell me what you're making. Email me or message me on LinkedIn.">
  <PageHead kicker="Contact" title="Tell me what you're making." lede="A few lines is enough: what it is, who it's for, and when." />
  <section class="wrap section">
    <a class="mail" href={`mailto:${P.profile.email}`} data-track="CTA Click" data-track-id="contact-email">{P.profile.email}<span aria-hidden="true"> →</span></a>
    <p class="label alt">Or <a href={P.profile.linkedin} rel="me noopener">LinkedIn</a> · <span class="muted">nothing you type here is stored by this site</span></p>
  </section>
</Base>
<style>
  .mail { display: inline-block; font-size: clamp(1.5rem, 0.6rem + 4.4vw, 4.5rem); font-weight: 800; letter-spacing: -0.045em; line-height: 1.05; text-decoration: none; overflow-wrap: anywhere; background: linear-gradient(var(--color-a-fill), var(--color-a-fill)) left 88% / 0 0.28em no-repeat; transition: background-size 300ms var(--ease-standard); }
  @media (hover: hover) { .mail:hover { background-size: 100% 0.28em; } }
  .mail:focus-visible { background-size: 100% 0.28em; }
  .mail span { color: var(--color-b); }
  .alt { margin-top: var(--space-8); }
  .alt a { color: var(--color-b); }
</style>
