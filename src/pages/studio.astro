---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';
import { href } from '../lib/href';
const P = JSON.parse(readFileSync(join(process.cwd(), 'content/portfolio.json'), 'utf8'));
const studio = P.services.filter((s: any) => s.title !== 'AI workflows');
const automate = P.services.find((s: any) => s.title === 'AI workflows');
const steps = [
  { t: 'Brief', d: 'One call: what you need, who it is for, where it runs.' },
  { t: 'Sketch by hand', d: 'Storyboard, layout or flow before anything is generated.', c: 'a' },
  { t: 'Make with AI', d: 'People make the calls; AI and automation carry the repeats.', c: 'b' },
  { t: 'Ship', d: 'Files, sources and how it was made. No black boxes.' },
];
---
<Base title="Studio" description="Studio makes video, motion and design. Automate builds workflows and tools for your team.">
  <PageHead kicker="Studio" title="Craft where it counts. Automation for the rest." />

  <section class="wrap section">
    <div class="pair">
      <div class="side side-a">
        <p class="label">Studio · done for you</p>
        <h2 class="side-t">We make it.</h2>
        <ul class="plain" role="list">{studio.map((s: any) => <li><b>{s.title}</b><span>{s.tags.join(' · ')}</span></li>)}</ul>
      </div>
      <div class="side side-b">
        <p class="label">Automate · built for you</p>
        <h2 class="side-t">We build the machine.</h2>
        <ul class="plain" role="list">
          {automate && <li><b>{automate.title}</b><span>{automate.tags.join(' · ')}</span></li>}
          <li><b>Tools</b><span><a href={href('/tools/')}>ContentIntel · CutPilot · Pulse</a></span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="room-h"><span class="label n">( 01 )</span> How a project runs</h2>
    <ol class="steps" role="list">
      {steps.map((s, i) => <li class={s.c ? `c-${s.c}` : ''}><span class="label">{String(i + 1).padStart(2, '0')}</span><b>{s.t}</b><span>{s.d}</span></li>)}
    </ol>
  </section>

  <section class="wrap section">
    <h2 class="room-h"><span class="label n">( 02 )</span> Who for</h2>
    <p class="verticals">Finance and fintech · Edtech · Medical and health</p>
    <p class="cta"><a class="btn btn-primary" href={href('/contact/')} data-track="CTA Click" data-track-id="studio-talk">Start a project <span class="arrow" aria-hidden="true">→</span></a></p>
  </section>
</Base>
<style>
  .pair { display: grid; gap: var(--space-4); }
  /* subgrid: both cards share row heights, so the two headlines sit on one line */
  .side { display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-6); border: 1px solid var(--color-text); min-height: 22rem; }
  .side .label { color: inherit; margin: 0; }
  .side-a { background: var(--color-a-fill); color: var(--color-a-ink); }
  .side-b { background: var(--color-b); color: var(--color-b-ink); }
  .side-t { font-size: var(--t-row); font-weight: 800; letter-spacing: -0.045em; line-height: 0.98; margin: auto 0 0; }
  @media (min-width: 48rem) { .pair { grid-template-columns: 1fr 1fr; grid-template-rows: auto 1fr auto; } .side { display: grid; grid-row: span 3; grid-template-rows: subgrid; gap: var(--space-4); } .side-t { margin: 0; align-self: end; } }
  .plain { list-style: none; margin: 0; padding: 0; border-top: 1px solid currentColor; }
  .plain li { display: grid; gap: 2px; padding: var(--space-3) 0; border-bottom: 1px solid currentColor; }
  .plain span { font-size: var(--text-sm); }
  .plain a { color: inherit; }
  .room-h { display: flex; gap: var(--space-4); align-items: baseline; font-size: var(--t-row); font-weight: 800; letter-spacing: -0.045em; line-height: 1; }
  .room-h .n { color: var(--color-b); letter-spacing: 0.06em; font-weight: 500; }
  .steps { list-style: none; margin: var(--space-6) 0 0; padding: 0; display: grid; gap: var(--space-6); }
  @media (min-width: 48rem) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .steps li { display: grid; gap: var(--space-1); padding-top: var(--space-3); border-top: 2px solid var(--color-text); }
  .steps .c-a { border-top-color: var(--color-a-fill); }
  .steps .c-b { border-top-color: var(--color-b); }
  .steps li > span:last-child { color: var(--color-text-muted); font-size: var(--text-sm); }
  .verticals { font-size: var(--t-row-sm); font-weight: 700; letter-spacing: -0.02em; }
  .cta { margin-top: var(--space-8); }
</style>
