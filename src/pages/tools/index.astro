---
import PageHead from '../../components/PageHead.astro';
import BuiltTabs from '../../components/BuiltTabs.astro';
import Base from '../../layouts/Base.astro';
import StandIn from '../../components/StandIn.astro';
import { loadContent } from '../../lib/content';
import { href } from '../../lib/href';
const { tools } = loadContent();
const STATUS: Record<string, string> = { live: 'Live', beta: 'Beta', 'private-beta': 'Private beta', 'in-development': 'In development', archived: 'Archived' };
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="Tools" description="Software I built for video, images and creator workflows: plugins, web apps and small utilities.">
  <PageHead kicker="Tools" title="Software that does the grind." count={tools.length} />
  <BuiltTabs />
  <section class="wrap section">
    <ol class="cat" role="list">
      {tools.map((t, i) => (
        <li>
          <a class="cat-row" href={href(`/tools/${t.slug}/`)}>
            <span class="c-n label">{pad(i + 1)}</span>
            <span class="c-t">{t.title} {t.standIn && <StandIn />}</span>
            <span class="c-s">{t.summary}</span>
            <span class="c-m label">{t.platforms[0] ?? t.category}</span>
            <span class="c-y label">{STATUS[t.status]}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
