---
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';
import { libraryItems } from '../lib/library';
import { href } from '../lib/href';
const items = libraryItems();
const kinds = [...new Set(items.map((i) => i.kind))].sort();
const counts = Object.fromEntries(kinds.map((k) => [k, items.filter((i) => i.kind === k).length]));
---
<Base title="Library" description="Everything on the site in one searchable list: free resources, skills, tools, experiments, work and code.">
  <PageHead kicker="Library" title="Everything, in one list." count={items.length} />
  <section class="wrap section">
    <form class="lib-search" role="search" data-index={href('/search-index.json')} data-base={href('/')}>
      <label for="q" class="label">Search everything</label>
      <input id="q" type="search" autocomplete="off" placeholder="thumbnail, skill, video…" />
      <label for="kind" class="visually-hidden">Kind</label>
      <select id="kind"><option value="">All kinds ({items.length})</option>{kinds.map((k) => <option value={k}>{k} ({counts[k]})</option>)}</select>
      <p class="lib-count label" role="status" aria-live="polite"></p>
    </form>
    <ol class="cat lib" role="list">
      {items.map((i) => (
        <li data-kind={i.kind}><a class="cat-row" href={href(i.url)}><span class="c-t">{i.title}</span><span class="c-s">{i.summary}</span><span class="c-y label">{i.kind}</span></a></li>
      ))}
    </ol>
  </section>
</Base>
<script>
  type Item = { k: string; t: string; s: string; u: string; y: number; o: string[] };
  const form = document.querySelector<HTMLFormElement>('.lib-search')!;
  const q = form.querySelector<HTMLInputElement>('#q')!;
  const kind = form.querySelector<HTMLSelectElement>('#kind')!;
  const list = document.querySelector<HTMLOListElement>('.lib')!;
  const count = form.querySelector<HTMLElement>('.lib-count')!;
  const base = form.dataset.base || '/';
  form.addEventListener('submit', (e) => e.preventDefault());
  let index: Item[] | null = null;
  let reported = '';
  async function load() {
    if (index) return index;
    try { index = (await (await fetch(form.dataset.index!)).json()) as Item[]; } catch { index = []; }
    return index;
  }
  q.addEventListener('focus', load, { once: true });
  async function run() {
    const items = await load();
    const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    const hits = items.filter((i) => (!kind.value || i.k === kind.value) && terms.every((t) => `${i.t} ${i.s} ${i.k} ${i.o.join(' ')}`.toLowerCase().includes(t)));
    list.replaceChildren(...hits.map((i) => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = base + i.u.replace(/^\//, '');
      a.className = 'cat-row';
      a.innerHTML = '<span class="c-t"></span><span class="c-s"></span><span class="c-y label"></span>';
      a.children[0].textContent = i.t; a.children[1].textContent = i.s; a.children[2].textContent = i.k;
      li.append(a);
      return li;
    }));
    count.textContent = `${hits.length} result${hits.length === 1 ? '' : 's'}`;
    const result = hits.length ? 'match' : 'no-match';
    if (terms.length && result !== reported) { reported = result; (window as any).aiflohTrack?.('Site Search', { result }); }
  }
  let timer = 0;
  q.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(run, 150); });
  kind.addEventListener('change', run);
</script>
<style>
  .lib-search { display: grid; gap: var(--space-3); max-width: 48rem; margin: 0 0 var(--space-8); }
  .lib-search input { min-height: 72px; padding: 0 var(--space-4); background: var(--color-surface); color: var(--color-text); border: 1px solid var(--color-text); border-radius: 0; font: inherit; font-size: var(--t-row-sm); font-weight: 700; letter-spacing: -0.02em; box-shadow: 6px 6px 0 var(--color-text); }
  .lib-search input::placeholder { color: var(--color-text-muted); font-weight: 500; }
  .lib-search select { justify-self: start; min-height: 44px; padding: 0 var(--space-3); background: var(--color-surface); color: var(--color-text); border: 1px solid var(--color-line-strong); font: inherit; font-size: var(--text-sm); }
  .lib-count { margin: 0; min-height: 1.4em; color: var(--color-text-muted); }
  .lib :global(.cat-row) { grid-template-columns: minmax(0, 1fr) auto; }
  .lib :global(.cat-row .c-t), .lib :global(.cat-row .c-s) { grid-column: 1; }
  .lib :global(.cat-row .c-y) { grid-column: 2; grid-row: 1; }
  .lib :global(.cat-row .c-s) { grid-row: 2; }
</style>
