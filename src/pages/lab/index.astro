---
import PageHead from '../../components/PageHead.astro';
import BuiltTabs from '../../components/BuiltTabs.astro';
import Base from '../../layouts/Base.astro';
import StandIn from '../../components/StandIn.astro';
import { loadContent } from '../../lib/content';
import { href } from '../../lib/href';
const { experiments } = loadContent();
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Lab" description="Experiments, including the ones that failed. Each one says what I tried and what happened.">
  <PageHead kicker="Lab" title="Experiments, failures included." count={experiments.length} />
  <BuiltTabs />
  <section class="wrap section">
    <ol class="cat cat-big" role="list">
      {experiments.map((e, i) => (
        <li>
          <a class="cat-row" href={href(`/lab/${e.slug}/`)}>
            <span class="c-n label">{String(i + 1).padStart(2, '0')}</span>
            <span class="c-t">{e.title} {e.standIn && <StandIn />}</span>
            <span class="c-s">{e.question}</span>
            <span class="c-m label">{fmt(e.date)} · {e.tools.join(', ')}</span>
            <span class={`c-y label r r-${e.result}`}>{e.result}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
<style>
  .r { font-weight: 700; }
  .r-worked { color: var(--color-a) !important; }
  .r-partly { color: var(--color-b) !important; }
  .r-failed { color: var(--color-warn) !important; }
</style>
