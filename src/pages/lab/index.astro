---
import PageHead from '../../components/PageHead.astro';
import BuiltTabs from '../../components/BuiltTabs.astro';
import Base from '../../layouts/Base.astro';
import StandIn from '../../components/StandIn.astro';
import { loadContent } from '../../lib/content';
import { href } from '../../lib/href';
const { experiments } = loadContent();
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Lab" description="Experiments, including the ones that failed. Each one says what I tried and what happened.">
  <PageHead kicker="Lab" title="Experiments, failures included." lede="Each one says what I tried, what happened and what I'd do next." count={experiments.length} />
  <BuiltTabs />
  <section class="wrap section">
    <ol class="lab" role="list">
      {experiments.map((e) => (
        <li>
          <a href={href(`/lab/${e.slug}/`)}>
            <span class={`result r-${e.result}`}>{e.result}</span>
            <span class="t">{e.title}</span>
            <span class="q muted">{e.question}</span>
            <span class="m muted">{fmt(e.date)} · {e.tools.join(', ')} {e.standIn && <StandIn />}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
<style>
  .lab { list-style: none; padding: 0; margin: var(--space-8) 0 0; border-top: 1px solid var(--color-line); }
  .lab li { border-bottom: 1px solid var(--color-line); }
  .lab a { display: grid; gap: var(--space-1); padding: var(--space-6) 0; text-decoration: none; }
  .t { font-weight: 700; font-size: var(--text-lg); }
  .q, .m { font-size: var(--text-sm); }
  .result { justify-self: start; font-size: var(--text-xs); font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.1em 0.5em; border-radius: 4px; border: 1px solid currentColor; }
  .r-worked { color: var(--color-a); }
  .r-partly { color: var(--color-b); }
  .r-failed { color: var(--color-warn); }
  .r-ongoing { color: var(--color-text-muted); }
  @media (hover: hover) { .lab a:hover .t { text-decoration: underline; } }
</style>
