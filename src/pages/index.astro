---
// Home, v3 (Oct 2026). One idea carried through the whole page: two hands.
//   Lime is the marker in Vikas's hand: a drawn stroke, a highlighter fill. "Made by hand".
//   Cobalt is the machine: exact rules, numbers, the full stop. "AI or automated".
// One type rule (DECISIONS.md): Display / Row / Body / Label. Serif only inside Display, one word at a time.
// Order follows the visitor's jobs (SITE-BUILD.md Section 2): free thing first, then work, studio, tools, the person.
// Studied, not copied: recent Awwwards and Siteinspire portfolios (numbered indexes, labelled sections, status
// lines, square corners, one loud accent). Notes in DECISIONS.md.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import Boot from '../components/Boot.astro';
import CodeWordBox from '../components/CodeWordBox.astro';
import InAppBanner from '../components/InAppBanner.astro';
import StandIn from '../components/StandIn.astro';
import { loadContent, TYPE_LABEL } from '../lib/content';
import { href } from '../lib/href';

const P = JSON.parse(readFileSync(join(process.cwd(), 'content/portfolio.json'), 'utf8'));
const c = loadContent();

// Free: real skills first, then the newest of the rest. Six rows.
const byDate = [...c.resources].sort((a, b) => +new Date(b.date) - +new Date(a.date));
const freePicks = [...byDate.filter((r) => !r.standIn), ...byDate.filter((r) => r.standIn)].slice(0, 6);

const work = P.projects.slice(0, 6);
const STATUS: Record<string, string> = { live: 'Live', beta: 'Beta', 'private-beta': 'Private beta', 'in-development': 'In development', archived: 'Archived' };
const tools = c.tools;

const studio = P.services.filter((s: any) => s.title !== 'AI workflows');
const automate = P.services.find((s: any) => s.title === 'AI workflows');
const steps = [
  { a: 'Brief', body: 'A short call: what you need, who it is for, where it will run.' },
  { a: 'Sketch', body: 'Storyboards, layouts and flows, by hand, before anything is generated.' },
  { a: 'Make', body: 'People make the calls. AI and automation carry the repetitive parts.' },
  { a: 'Ship', body: 'Files, sources and how it was made. Then variants and support.' },
];
---
<Base title="Vikas Banjare" description="Vikas Banjare (Bubu): designer, editor and storyteller. Video, design, UI/UX and AI workflows. Founder of AI-Floh.">
  <Boot />
  <div class="wrap"><InAppBanner /></div>

  <!-- HERO: a status line, one sentence, the code-word box. -->
  <section class="hero wrap" aria-labelledby="hero-h">
    <p class="status label rise">
      <span><span class="live" aria-hidden="true" />{P.profile.availability}</span>
      <span><time data-clock>India (IST)</time></span>
      <a href={`mailto:${P.profile.email}`}>{P.profile.email}</a>
    </p>
    <h1 id="hero-h" class="display rise-2">
      <span class="l1">I keep the <span class="hand">craft<svg class="stroke" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 15c40-7 92-10 146-8 50 2 97 1 146-6" /><path d="M14 20c64-6 140-7 212-4" /></svg></span><span class="stop-a">.</span></span>
      <span class="l2">I automate the&nbsp;grind<span class="stop-b">.</span></span>
    </h1>
    <div class="hero-foot rise-3">
      <p class="intro">
        I'm Vikas, Bubu to most. Designer, video editor and storyteller: eight years, 1000+ projects.
        These days I also build the tools and Claude skills that take the repetitive parts off the job, under my studio, AI-Floh.
      </p>
      <div class="cw-plate">
        <p class="note" aria-hidden="true">the word from my post goes here
          <svg viewBox="0 0 60 50" class="note-arrow"><path d="M4 4c10 2 26 10 34 22 4 6 6 12 7 18" /><path d="M36 38l9 7 6-11" /></svg>
        </p>
        <CodeWordBox id="cw-home" />
      </div>
    </div>
  </section>

  <!-- 01 FREE -->
  <section class="block wrap" aria-labelledby="free-h">
    <header class="b-head">
      <p class="label"><span class="n">( 01 )</span> Free</p>
      <h2 id="free-h" class="row-title">Take something useful.</h2>
      <p class="b-note">Prompts, Claude skills and templates from my own work. No sign-up.</p>
    </header>
    <ol class="index" role="list">
      {freePicks.map((r, i) => (
        <li>
          <a class="ix" href={href(`/free/${r.slug}/`)}>
            <span class="ix-n label">{String(i + 1).padStart(2, '0')}</span>
            <span class="ix-t">{r.title} {r.standIn && <StandIn />}</span>
            <span class="ix-m label">{TYPE_LABEL[r.type]}</span>
            <span class="ix-w label">/{r.codeWord}</span>
            <span class="ix-a" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="more"><a class="btn btn-primary" href={href('/free/')}>All {c.resources.length} free things <span class="arrow" aria-hidden="true">→</span></a></p>
  </section>

  <!-- 02 WORK -->
  <section class="block wrap" id="work" aria-labelledby="work-h">
    <header class="b-head">
      <p class="label"><span class="n">( 02 )</span> Work</p>
      <h2 id="work-h" class="row-title">Selected work.</h2>
      <p class="b-note">Video, design and web from the last three years. Full projects live on Behance for now.</p>
    </header>
    <ol class="index" role="list" data-work>
      {work.map((w: any, i: number) => (
        <li>
          <a class="ix" href={w.link} rel="noopener" data-cover={w.cover ? href(w.cover) : undefined}>
            <span class="ix-n label">{String(i + 1).padStart(2, '0')}</span>
            <span class="ix-t">{w.title}</span>
            <span class="ix-m label">{w.tags.join(', ')}</span>
            <span class="ix-w label">{w.year}</span>
            <span class="ix-a" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
    <img class="w-float" alt="" width="360" height="240" hidden decoding="async" />
    <p class="more"><a class="btn" href={P.profile.behance} rel="noopener">All {P.projects.length} on Behance <span class="arrow" aria-hidden="true">↗</span></a></p>
  </section>

  <!-- 03 STUDIO -->
  <section class="block wrap" aria-labelledby="studio-h">
    <header class="b-head">
      <p class="label"><span class="n">( 03 )</span> Studio</p>
      <h2 id="studio-h" class="row-title">Two ways to work with AI-Floh.</h2>
    </header>
    <div class="pillars">
      <div class="pillar">
        <p class="label"><span class="sw sw-a" aria-hidden="true" />Studio · done for you</p>
        <p class="p-lede">We make the thing: films, edits, designs and pages, with a person on every decision.</p>
        <ul class="plain" role="list">
          {studio.map((s: any) => <li><b>{s.title}</b><span>{s.tags.join(' · ')}</span></li>)}
        </ul>
      </div>
      <div class="pillar">
        <p class="label"><span class="sw sw-b" aria-hidden="true" />Automate · built for you</p>
        <p class="p-lede">We build the machine: workflows, plugins and Claude skills that take the repeat work off your team.</p>
        <ul class="plain" role="list">
          {automate && <li><b>{automate.title}</b><span>{automate.tags.join(' · ')}</span></li>}
          <li><b>Tools</b><span>{tools.map((t) => t.title).slice(0, 3).join(' · ')}</span></li>
        </ul>
      </div>
    </div>
    <ol class="steps" role="list" aria-label="How a project runs">
      {steps.map((s, i) => (
        <li><span class="label">{String(i + 1).padStart(2, '0')}</span><b>{s.a}</b><span>{s.body}</span></li>
      ))}
    </ol>
    <p class="more"><a class="btn" href={href('/studio/')}>How a project runs <span class="arrow" aria-hidden="true">→</span></a></p>
  </section>

  <!-- 04 BUILT -->
  <section class="block wrap" aria-labelledby="built-h">
    <header class="b-head">
      <p class="label"><span class="n">( 04 )</span> Built</p>
      <h2 id="built-h" class="row-title">Software I made to skip the grind.</h2>
    </header>
    <div class="built">
      <ol class="index" role="list">
        {tools.map((t, i) => (
          <li>
            <a class="ix" href={href(`/tools/${t.slug}/`)}>
              <span class="ix-n label">{String(i + 1).padStart(2, '0')}</span>
              <span class="ix-t">{t.title} {t.standIn && <StandIn />}</span>
              <span class="ix-m label">{t.platforms.slice(0, 2).join(', ') || t.category}</span>
              <span class="ix-w label">{STATUS[t.status]}</span>
              <span class="ix-a" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
      <figure class="plate">
        <img src={href('/media/portfolio/contentintel-site.webp')} alt="The ContentIntel website: a dark landing page reading Know it'll work before you hit publish" width="900" height="1347" loading="lazy" decoding="async" />
        <figcaption class="label">ContentIntel · contentintel.in</figcaption>
      </figure>
    </div>
    <p class="more"><a class="btn" href={href('/tools/')}>Tools, experiments and code <span class="arrow" aria-hidden="true">→</span></a></p>
  </section>

  <!-- 05 ABOUT -->
  <section class="block wrap" aria-labelledby="about-h">
    <header class="b-head">
      <p class="label"><span class="n">( 05 )</span> About</p>
      <h2 id="about-h" class="row-title">The person behind it.</h2>
    </header>
    <div class="about">
      <figure class="me">
        <img src={href(P.profile.photo)} alt={P.profile.name} width="230" height="230" loading="lazy" />
        <figcaption class="label">{P.profile.nickname} · {P.profile.name}</figcaption>
      </figure>
      <div>
        <p class="p-lede">Eight years across video production, motion graphics, brand design, UI/UX and content strategy. I make the work, and I build the shortcuts that let me make more of it. The taste stays human.</p>
        <dl class="stats">
          {P.stats.map((s: any) => <div><dt class="label">{s.label}</dt><dd>{s.value}</dd></div>)}
        </dl>
        <p class="more"><a class="btn" href={href('/about/')}>More about me <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Local time in India, display only; nothing stored.
  const clocks = document.querySelectorAll<HTMLElement>('[data-clock]');
  const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata', hour12: false });
  const tick = () => clocks.forEach((el) => (el.textContent = `${fmt.format(new Date())} in India`));
  tick();
  setInterval(tick, 30000);

  // Cover preview that follows the pointer on the work index (fine pointers only, rows with a cover only).
  const list = document.querySelector<HTMLElement>('[data-work]');
  const float = document.querySelector<HTMLImageElement>('.w-float');
  if (list && float && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let x = 0, y = 0, raf = 0;
    const move = () => { raf = 0; float.style.transform = `translate(${x}px, ${y}px)`; };
    list.addEventListener('pointermove', (e) => {
      const src = (e.target as HTMLElement).closest<HTMLElement>('.ix')?.dataset.cover;
      if (src) { if (float.getAttribute('src') !== src) float.src = src; float.hidden = false; } else float.hidden = true;
      x = e.clientX + 28; y = e.clientY - 120;
      if (!raf) raf = requestAnimationFrame(move);
    });
    list.addEventListener('pointerleave', () => (float.hidden = true));
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero { padding-block: var(--space-8) var(--space-16); }
  .hero-foot > * { min-width: 0; }
  .status { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-bottom: var(--space-12); }
  .status a { color: var(--color-b); }
  .live { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--color-a-fill); box-shadow: 0 0 0 1px var(--color-text); margin-right: 0.6em; vertical-align: 0.05em; }
  .display { font-size: var(--t-display); font-weight: 800; letter-spacing: -0.055em; line-height: 0.92; margin: 0; max-width: none; }
  .display .l2 { display: block; }
  .hand { position: relative; font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.02em; padding-inline: 0.04em; white-space: nowrap; }
  .stroke { position: absolute; left: -2%; right: -4%; bottom: -0.02em; width: 106%; height: 0.32em; z-index: -1; overflow: visible; }
  .stroke path { fill: none; stroke: var(--color-a-fill); stroke-width: 9; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .stroke path + path { stroke-width: 5; opacity: 0.8; }
  .stop-a { color: var(--color-a); }
  .stop-b { color: var(--color-b); }
  .hero-foot { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-8); margin-top: var(--space-12); padding-top: var(--space-8); border-top: 1px solid var(--color-text); }
  .intro { font-size: var(--t-body); max-width: 46ch; margin: 0; }
  .cw-plate { position: relative; border: 1px solid var(--color-text); background: var(--color-surface); padding: var(--space-6); max-width: min(30rem, calc(100% - 6px)); box-shadow: 6px 6px 0 var(--color-text); }
  /* A margin note in Vikas's hand (desktop only): the one place the serif leaves the headline. */
  .note { display: none; }
  @media (min-width: 72rem) {
    .note {
      display: block; position: absolute; right: calc(100% + 1.25rem); top: -0.5rem; width: 13rem; margin: 0;
      font-family: var(--font-serif); font-style: italic; font-size: 1.375rem; line-height: 1.1; color: var(--color-b); text-align: right; transform: rotate(-4deg);
    }
    .note-arrow { position: absolute; right: -2.6rem; top: 1.6rem; width: 3rem; height: 2.5rem; overflow: visible; }
    .note-arrow path { fill: none; stroke: var(--color-b); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  }
  @media (min-width: 56rem) {
    .hero-foot { grid-template-columns: 1fr minmax(0, 28rem); align-items: start; }
    .cw-plate { justify-self: end; width: 100%; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .stroke path { stroke-dasharray: 400; stroke-dashoffset: 400; animation: draw 700ms var(--ease-standard) 420ms forwards; }
    .stroke path + path { animation-delay: 620ms; }
    :global(html.booting) .stroke path { animation-play-state: paused; }
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  /* ---------- blocks ---------- */
  .block { padding-block: var(--space-16); background: linear-gradient(var(--color-text), var(--color-text)) top center / calc(100% - 2 * var(--gutter)) 1px no-repeat; }
  .b-head { display: grid; gap: var(--space-3); margin-bottom: var(--space-8); }
  .b-head .label { margin: 0; }
  .n { color: var(--color-b); margin-right: 0.4em; }
  .row-title { font-size: var(--t-row); font-weight: 750; letter-spacing: -0.035em; line-height: 1.05; margin: 0; }
  .b-note { margin: 0; color: var(--color-text-muted); max-width: 48ch; }
  @media (min-width: 64rem) {
    .block { display: grid; grid-template-columns: 15rem minmax(0, 1fr); column-gap: var(--space-8); }
    .b-head { grid-column: 1 / -1; grid-template-columns: 15rem minmax(0, 1fr); column-gap: var(--space-8); align-items: baseline; }
    .b-head > :not(.label) { grid-column: 2; }
    .block > :not(.b-head):not(.w-float) { grid-column: 2; }
  }
  .more { margin: var(--space-8) 0 0; }

  /* ---------- the numbered index (used for free, work and tools) ---------- */
  .index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-line-strong); }
  .index li { border-bottom: 1px solid var(--color-line-strong); }
  .ix {
    position: relative; display: grid; grid-template-columns: 2.25rem minmax(0, 1fr) auto; column-gap: var(--space-3); row-gap: var(--space-1);
    align-items: baseline; padding: var(--space-4) 0; text-decoration: none; isolation: isolate;
  }
  .ix-n { color: var(--color-text-muted); grid-row: 1 / span 2; }
  .ix-t { font-weight: 650; font-size: var(--t-body); letter-spacing: -0.01em; }
  .ix-m { grid-column: 2; color: var(--color-text-muted); }
  .ix-w { grid-column: 3; grid-row: 1; color: var(--color-text-muted); }
  .ix-a { display: none; }
  @media (min-width: 48rem) {
    .ix { grid-template-columns: 3rem minmax(0, 1fr) 14rem 7rem 1.5rem; padding: var(--space-6) 0; }
    .ix-n, .ix-m, .ix-w, .ix-a { grid-row: 1; }
    .ix-m { grid-column: 3; }
    .ix-w { grid-column: 4; }
    .ix-a { display: block; grid-column: 5; text-align: right; color: var(--color-b); }
    .ix-t { font-size: var(--t-row-sm); font-weight: 700; letter-spacing: -0.03em; }
  }
  /* The highlighter: lime slides in under the row, the way a marker would. */
  .ix::before { content: ''; position: absolute; inset: 0 -0.75rem; z-index: -1; background: var(--color-a-fill); transform: scaleX(0); transform-origin: left; transition: transform 240ms var(--ease-standard); }
  @media (hover: hover) { .ix:hover::before { transform: scaleX(1); } .ix:hover .ix-n, .ix:hover .ix-m, .ix:hover .ix-w { color: var(--color-text); } }
  .ix:focus-visible::before { transform: scaleX(1); }

  .w-float { position: fixed; left: 0; top: 0; z-index: 60; width: 300px; height: auto; pointer-events: none; border: 1px solid var(--color-text); box-shadow: 6px 6px 0 var(--color-text); }

  /* ---------- studio ---------- */
  .pillars { display: grid; gap: var(--space-8); }
  @media (min-width: 48rem) { .pillars { grid-template-columns: 1fr 1fr; gap: 0; } .pillar + .pillar { border-left: 1px solid var(--color-line-strong); padding-left: var(--space-8); } .pillar:first-child { padding-right: var(--space-8); } }
  .pillar .label { display: flex; align-items: center; gap: var(--space-2); }
  .sw { width: 12px; height: 12px; display: inline-block; border: 1px solid var(--color-text); }
  .sw-a { background: var(--color-a-fill); }
  .sw-b { background: var(--color-b); }
  .p-lede { font-size: var(--t-lede); line-height: 1.4; letter-spacing: -0.015em; max-width: 34ch; }
  .plain { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-line); }
  .plain li { display: grid; gap: var(--space-1); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-line); }
  .plain span { color: var(--color-text-muted); font-size: var(--text-sm); }
  .steps { list-style: none; margin: var(--space-12) 0 0; padding: 0; display: grid; gap: var(--space-6); counter-reset: s; }
  .steps li { display: grid; gap: var(--space-1); padding-top: var(--space-3); border-top: 2px solid var(--color-b); }
  .steps li:nth-child(2) { border-top-color: var(--color-a-fill); }
  .steps b { font-size: var(--t-body); }
  .steps span:last-child { color: var(--color-text-muted); font-size: var(--text-sm); }
  @media (min-width: 48rem) { .steps { grid-template-columns: repeat(4, 1fr); } }

  /* ---------- built ---------- */
  .built { display: grid; gap: var(--space-8); }
  .plate { margin: 0; border: 1px solid var(--color-text); background: var(--color-surface); max-width: 22rem; }
  .plate img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; }
  .plate figcaption { padding: var(--space-2) var(--space-3); border-top: 1px solid var(--color-text); }
  @media (min-width: 64rem) { .built { grid-template-columns: minmax(0, 1fr) 15rem; align-items: start; } .built .ix { grid-template-columns: 3rem minmax(0, 1fr) 9rem 6.5rem 1.5rem; } }
  @media (max-width: 63.99rem) { .plate { display: none; } }

  /* ---------- about ---------- */
  .about { display: grid; gap: var(--space-8); }
  @media (min-width: 48rem) { .about { grid-template-columns: 12rem minmax(0, 1fr); } }
  .me { margin: 0; border: 1px solid var(--color-text); background: var(--color-surface); max-width: 12rem; }
  .me img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; filter: grayscale(0.15); }
  .me figcaption { padding: var(--space-2) var(--space-3); border-top: 1px solid var(--color-text); }
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0; margin: var(--space-8) 0 0; border-top: 1px solid var(--color-line-strong); }
  .stats div { padding: var(--space-4) var(--space-4) var(--space-4) 0; border-bottom: 1px solid var(--color-line-strong); display: flex; flex-direction: column-reverse; gap: var(--space-1); }
  .stats dd { margin: 0; font-size: var(--t-row); font-weight: 800; letter-spacing: -0.05em; line-height: 1; }
  .stats div:nth-child(2) dd { background: linear-gradient(transparent 55%, var(--color-a-fill) 55%, var(--color-a-fill) 90%, transparent 90%); justify-self: start; align-self: flex-start; }
  @media (min-width: 64rem) { .stats { grid-template-columns: repeat(5, 1fr); } }
</style>
