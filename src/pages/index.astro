---
// Home, v5 (Oct 2026): opens as a short film, then the rooms.
//   The film: Lino (the hand, lime clay) draws a line; Bit (the machine, a cobalt box) finishes it. Scroll is the playhead.
//   Sections read like rooms; rows read like wall labels (title, medium, year). Free things are "Take one",
//   like the free prints at a gallery door. Few words, big type, lots of air.
// Rules kept: one type rule (DECISIONS.md), lime as fill/stroke only, works without JS, no style attributes (CSP).
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import Boot from '../components/Boot.astro';
import CodeWordBox from '../components/CodeWordBox.astro';
import InAppBanner from '../components/InAppBanner.astro';
import StandIn from '../components/StandIn.astro';
import Wall from '../components/Wall.astro';
import { loadContent, TYPE_LABEL } from '../lib/content';
import { href } from '../lib/href';

const P = JSON.parse(readFileSync(join(process.cwd(), 'content/portfolio.json'), 'utf8'));
const c = loadContent();

const byDate = [...c.resources].sort((a, b) => +new Date(b.date) - +new Date(a.date));
const freePicks = [...byDate.filter((r) => !r.standIn), ...byDate.filter((r) => r.standIn)].slice(0, 5);
const work = P.projects.slice(0, 6);
const STATUS: Record<string, string> = { live: 'Live', beta: 'Beta', 'private-beta': 'Private beta', 'in-development': 'In development', archived: 'Archived' };
const pad = (n: number) => String(n).padStart(2, '0');

// The film: a real scroll-scrubbed video when content/hero.json has one, otherwise the 3D clay room.
const HERO = JSON.parse(readFileSync(join(process.cwd(), 'content/hero.json'), 'utf8'));
const HV = HERO.video as null | { wide: string; tall?: string; posterStart: string; posterStartTall?: string; posterEnd: string; posterEndTall?: string; alt: string; alarmAt?: number; shots?: number[] };
const filmShots = JSON.stringify(HV?.shots ?? [0.1, 0.26, 0.34, 0.5, 0.78, 0.94]);
const filmAlarm = String(HV?.alarmAt ?? 0.26);
const posters = HV
  ? { start: HV.posterStart, startTall: HV.posterStartTall ?? HV.posterStart, end: HV.posterEnd, endTall: HV.posterEndTall ?? HV.posterEnd, alt: HV.alt }
  : { start: '/media/film/room-start.webp', startTall: '/media/film/room-start-tall.webp', end: '/media/film/room-end.webp', endTall: '/media/film/room-end-tall.webp',
      alt: 'A miniature clay bedroom: an unmade bed with a blue blanket, a bedside clock, type posters on the wall, and a young man at his desk editing a video under a sunny window.' };

---
<Base title="Vikas Banjare" description="Vikas Banjare (Bubu): designer, editor and storyteller. Video, design, UI/UX and AI workflows. Founder of AI-Floh." intro>
  <Boot />
  <div class="wrap"><InAppBanner /></div>

  <!-- The film: a miniature clay room. Scrolling is the playhead. Without JS or with reduced motion it is one still
       frame (the whole room) with the headline. -->
  <section class="film" aria-labelledby="hero-h">
    <div class="film-stage" data-shot="0" data-shots={filmShots} data-alarm={filmAlarm}>
      {HV && <video class="film-video" muted playsinline preload="none" aria-hidden="true" tabindex="-1" data-wide={href(HV.wide)} data-tall={HV.tall ? href(HV.tall) : undefined} data-wide-webm={href(HV.wide.replace(/\.mp4$/, '.webm'))} data-tall-webm={HV.tall ? href(HV.tall.replace(/\.mp4$/, '.webm')) : undefined}></video>}
      <picture class="film-poster poster-start">
        <source media="(max-aspect-ratio: 4/5)" srcset={href(posters.startTall)} width="900" height="1600" />
        <img src={href(posters.start)} alt="" width="1600" height="900" fetchpriority="high" decoding="async" />
      </picture>
      <picture class="film-poster poster-end">
        <source media="(max-aspect-ratio: 4/5)" srcset={href(posters.endTall)} width="900" height="1600" />
        <img src={href(posters.end)} alt={posters.alt} width="1600" height="900" decoding="async" />
      </picture>
      <p class="hud" aria-hidden="true"><span data-hud-time>12:57</span><span class="hud-pm">PM</span><span class="hud-where label">in India</span></p>
      <h1 id="hero-h" class="subs">
        <span class="s1">I keep the <span class="hand">craft</span><span class="stop-a">.</span></span>
        <span class="s2">I automate the&nbsp;grind<span class="stop-b">.</span></span>
      </h1>
      <a class="skip-film" href="#start">Skip intro <span aria-hidden="true">↓</span></a>
      <p class="status label"><span><span class="live" aria-hidden="true"></span>{P.profile.availability}</span> <span data-clock>India</span></p>
    </div>
  </section>

  <div class="day day-light">
  <section class="endcard wrap" id="start" aria-label="Who and how to start">
    <div class="who-wrap">
      <p class="who">Vikas Banjare, or Bubu. Designer, editor, storyteller. 8+&nbsp;years, 1000+&nbsp;projects.</p>
      <p class="who-cta"><a class="btn btn-primary btn-lime" href={href('/contact/')} data-track="CTA Click" data-track-id="hero-talk">Start a project <span class="arrow" aria-hidden="true">→</span></a> <a class="see" href="#work">or see the work ↓</a></p>
    </div>
    <div class="cw-plate">
      <CodeWordBox id="cw-home" />
    </div>
  </section>

  <section class="room wrap" id="work" aria-labelledby="work-h">
    <h2 id="work-h" class="room-h"><span class="label n chip" aria-hidden="true">1:15 PM</span> <span>Work<span class="stop-b">.</span></span></h2>
    <Wall items={P.projects} start={1} limit={6} />
    <p class="more"><a class="btn" href={P.profile.behance} rel="noopener">All {P.projects.length} on Behance <span class="arrow" aria-hidden="true">↗</span></a></p>
  </section>

  <section class="room wrap" aria-labelledby="free-h">
    <h2 id="free-h" class="room-h"><span class="label n chip" aria-hidden="true">3:00 PM</span> <span>Free<span class="stop-a">.</span></span></h2>
    <ol class="index" role="list">
      {freePicks.map((r, i) => (
        <li>
          <a class="ix" href={href(`/free/${r.slug}/`)}>
            <span class="ix-n label">{pad(i + 1)}</span>
            <span class="ix-t">{r.title} {r.standIn && <StandIn />}</span>
            <span class="ix-m label">{TYPE_LABEL[r.type]}</span>
            <span class="ix-w label">/{r.codeWord}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="more"><a class="btn btn-primary" href={href('/free/')}>All {c.resources.length} free <span class="arrow" aria-hidden="true">→</span></a></p>
  </section>

  <section class="room wrap" aria-labelledby="studio-h">
    <h2 id="studio-h" class="room-h"><span class="label n chip" aria-hidden="true">4:30 PM</span> <span>Studio<span class="stop-a">.</span></span></h2>
    <div class="pair">
      <a class="side side-a" href={href('/studio/')}>
        <span class="label"><i class="k k-a" aria-hidden="true"></i>Studio</span>
        <span class="side-t">We make it.</span>
        <span class="side-m">Video · Design · UI/UX</span>
      </a>
      <a class="side side-b" href={href('/studio/')}>
        <span class="label"><i class="k k-b" aria-hidden="true"></i>Automate</span>
        <span class="side-t">We build the machine.</span>
        <span class="side-m">Workflows · Plugins · Claude skills</span>
      </a>
    </div>
    <figure class="still">
      <img src={href('/media/day/at-work.webp')} alt="Animated still from the film: Vikas grinning at two monitors full of a video edit, afternoon sun through the window." width="1200" height="800" loading="lazy" decoding="async" />
      <figcaption class="label">Fig. 7 · 4:30 PM, deep in an edit</figcaption>
    </figure>
    <ol class="steps" role="list" aria-label="How a project runs">
      <li><span class="s-n" aria-hidden="true">01</span><b>Brief</b><span class="s-d">One call: what you need, who it is for, where it runs.</span></li>
      <li class="s-a"><span class="s-n" aria-hidden="true">02</span><b>Sketch by hand</b><span class="s-d">Storyboard, layout or flow before anything is generated.</span></li>
      <li class="s-b"><span class="s-n" aria-hidden="true">03</span><b>Make with AI</b><span class="s-d">People make the calls; AI and automation carry the repeats.</span></li>
      <li class="s-c"><span class="s-n" aria-hidden="true">04</span><b>Ship</b><span class="s-d">Files, sources and how it was made. No black boxes.</span></li>
    </ol>
  </section>

  </div>

  <figure class="dusk">
    <img src={href('/media/day/dusk-7pm.webp')} srcset={`${href('/media/day/dusk-7pm-960.webp')} 960w, ${href('/media/day/dusk-7pm.webp')} 1920w`} sizes="100vw" width="1920" height="1080" loading="lazy" decoding="async" alt="Animated still from the film, graded to sunset: the city glows orange under a violet sky, and Vikas is still at his desk in the lit window." />
    <figcaption class="label wrap"><span>Fig. 8 · 7:00 PM, the sun goes down. He's still at it.</span></figcaption>
  </figure>

  <div class="day day-dark">
  <section class="room room-m wrap" aria-labelledby="built-h">
    <h2 id="built-h" class="room-h"><span class="label n chip" aria-hidden="true">7:00 PM</span> <span>Tools<span class="stop-b">.</span></span></h2>
    <div class="built">
      <ol class="index" role="list">
        {c.tools.map((t, i) => (
          <li>
            <a class="ix" href={href(`/tools/${t.slug}/`)}>
              <span class="ix-n label">{pad(i + 1)}</span>
              <span class="ix-t">{t.title} {t.standIn && <StandIn />}</span>
              <span class="ix-m label">{t.platforms[0] ?? t.category}</span>
              <span class="ix-w label">{STATUS[t.status]}</span>
            </a>
          </li>
        ))}
      </ol>
      <figure class="plate">
        <img src={href('/media/portfolio/contentintel-site.webp')} alt="The ContentIntel website: a dark landing page reading Know it'll work before you hit publish" width="900" height="1347" loading="lazy" decoding="async" />
        <figcaption class="label">Fig. 9 · ContentIntel</figcaption>
      </figure>
    </div>
    <p class="more"><a class="btn" href={href('/tools/')}>Tools, lab and code <span class="arrow" aria-hidden="true">→</span></a></p>
  </section>

  <section class="room wrap" aria-labelledby="about-h">
    <h2 id="about-h" class="room-h"><span class="label n chip" aria-hidden="true">11:30 PM</span> <span>About<span class="stop-a">.</span></span></h2>
    <div class="maker">
      <div class="me-pair">
        <figure class="me me-real">
          <img src={href(P.profile.photo)} alt={P.profile.name} width="230" height="230" loading="lazy" />
          <figcaption class="label">Fig. 10 · {P.profile.nickname}</figcaption>
        </figure>
        <figure class="me me-toon">
          <img src={href('/media/day/bubu-animated.webp')} alt={`${P.profile.nickname} as the animated character from the film`} width="720" height="720" loading="lazy" decoding="async" />
          <figcaption class="label">Fig. 11 · animated</figcaption>
        </figure>
      </div>
      <div class="stats">
        <dl>
          {P.stats.map((s: any) => <div><dt class="label">{s.label}</dt><dd>{s.value}</dd></div>)}
        </dl>
        <a class="stat-more" href={href('/about/')}><span class="label">The person behind it</span><span class="sm-t">About me <span class="arrow" aria-hidden="true">→</span></span></a>
      </div>
    </div>
  </section>
  </div>
</Base>

<script>
  import { track } from '../scripts/track';

  // The film. Scroll position is the playhead (native scroll, no hijacking): the stage is sticky inside a tall
  // section and the story follows progress. The poster is the first frame people see; the 3D room takes over once
  // the page is idle or someone moves, and steps back to the poster on slow devices.
  const film = document.querySelector<HTMLElement>('.film');
  const stage = film?.querySelector<HTMLElement>('.film-stage');
  const hudTime = stage?.querySelector<HTMLElement>('[data-hud-time]');
  const report = (mode: string) => track('Hero Mode', { mode });
  if (film && stage && hudTime) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) report('static-reduced-motion');
    else {
      film.classList.add('is-live');
      let progress = 0;
      // shots: 0 clock close-up · 1 asleep · 2 alarm · 3 up · 4 walk · 5 at work · 6 title
      const SHOTS = [0, ...JSON.parse(stage.dataset.shots || '[]')];
      const ALARM = Number(stage.dataset.alarm || 0.26);
      let shot = -1, lastTime = '';
      const measure = () => {
        const r = film.getBoundingClientRect();
        const run = film.offsetHeight - innerHeight;
        progress = run > 0 ? Math.min(1, Math.max(0, -r.top / run)) : 0;
        let s = 0;
        while (s < SHOTS.length - 1 && progress >= SHOTS[s + 1]) s++;
        if (s !== shot) { shot = s; stage.dataset.shot = String(s); }
        const minutes = progress < ALARM ? 57 + (progress / ALARM) * 3 : 60 + ((progress - ALARM) / (1 - ALARM)) * 14;
        const t = minutes >= 60 ? `1:${String(Math.floor(minutes - 60)).padStart(2, '0')}` : `12:${String(Math.floor(minutes))}`;
        if (t !== lastTime) { lastTime = t; hudTime.textContent = t; }
        // the last tenth of the scroll: the closing frame pushes in and blooms into the afternoon light of the end card
        stage.style.setProperty('--out', String(Math.min(1, Math.max(0, (progress - 0.9) / 0.1)).toFixed(3)));
      };
      let queued = false;
      addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; measure(); }); } }, { passive: true });
      addEventListener('resize', measure, { passive: true });
      measure();

      const video = stage.querySelector<HTMLVideoElement>('.film-video');
      if (video) {
        // the real film: scroll scrubs the video; the poster stays until its first frame is painted
        let started = false;
        const go = async () => {
          if (started) return;
          started = true;
          VEVENTS.forEach((ev) => removeEventListener(ev, go));
          const { mountScrub } = await import('../scripts/scrub');
          mountScrub(stage, video, () => progress, () => { stage.classList.add('is-video'); report('video'); });
        };
        const VEVENTS = ['pointermove', 'scroll', 'touchstart', 'keydown'] as const;
        VEVENTS.forEach((ev) => addEventListener(ev, go, { passive: true, once: true }));
        setTimeout(go, 1200);
      } else {
      const gl = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();
      if (!gl) report('static-no-webgl');
      else {
        let started = false;
        const go = async () => {
          if (started) return;
          started = true;
          EVENTS.forEach((ev) => removeEventListener(ev, go));
          const { mountRoom } = await import('../scripts/room3d');
          let probe = 0;
          const m = mountRoom(stage, () => progress, () => { stage.classList.add('is-3d'); probe = window.setTimeout(check, 2500); }, import.meta.env.BASE_URL.replace(/\/?$/, '/'));
          // Probe: 2.5 s after the first frame, fewer than 30 frames or a median above 34 ms means this device keeps the poster.
          // automated screenshot runs (software GPU) skip the probe so they can record the 3D
          const keep = navigator.webdriver === true;
          const check = () => {
            if (keep) return;
            const f = [...m.frameTimes].sort((a, b) => a - b);
            const median = f.length ? f[Math.floor(f.length / 2)] : 0;
            // too slow either way: frames too long, or too few frames at all
            if (f.length < 30 || median > 34) { m.dispose(); stage.classList.remove('is-3d'); report('static-low-power'); }
            else report('3d');
          };
          // a device that cannot even draw the first frame within 8 s keeps the poster too
          window.setTimeout(() => { if (!probe && !keep) { m.dispose(); report('static-low-power'); } }, 8000);
        };
        const EVENTS = ['pointermove', 'scroll', 'touchstart', 'keydown'] as const;
        EVENTS.forEach((ev) => addEventListener(ev, go, { passive: true, once: true }));
        const idle = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 1));
        setTimeout(() => idle(go, { timeout: 2000 }), 2500);
      }
      }
    }
  }

  const clocks = document.querySelectorAll<HTMLElement>('[data-clock]');
  const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata', hour12: false });
  const tick = () => clocks.forEach((el) => (el.textContent = `${fmt.format(new Date())} in India`));
  tick();
  setInterval(tick, 30000);

</script>

<style>
  /* ---------- the film ---------- */
  /* the film runs under the floating glass nav (the sticky header takes 66 px of flow: 10 px gap + 56 px bar) */
  .film { --night: #0e0c0f; position: relative; margin-top: -66px; background: var(--night); color: var(--color-bg); }
  .film.is-live { height: 720svh; }
  /* phones flick-scroll: a shorter run plays the same story with less thumb travel */
  @media (max-width: 47.99rem) { .film.is-live { height: 560svh; } }
  .film-stage { position: relative; height: 100svh; min-height: 30rem; overflow: hidden; background: var(--night); }
  .film.is-live .film-stage { position: sticky; top: 0; }
  .film-poster, .film-poster img, .film-stage :global(.film-canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover; }
  /* the live film opens on the clock; the still version shows the whole room */
  .poster-start { display: none; }
  .film.is-live .poster-start { display: block; }
  .film.is-live .poster-end { display: none; }
  .film-stage.is-3d .film-poster, .film-stage.is-video .film-poster { visibility: hidden; }
  .film-video { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover; background: var(--night);
    transform: scale(calc(1 + var(--out, 0) * 0.06)); filter: brightness(calc(1 + var(--out, 0) * 0.15)); }
  /* the end of the film blooms into the afternoon: the last frame washes out to the end card's sunlit paper,
     and the title card turns from white to ink as it does */
  .film-stage::before { content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; opacity: var(--out, 0);
    background: linear-gradient(to bottom, rgb(251 244 228 / 0.7), #fbf4e4 60%); }
  /* vignette: the sides and top fall off like a lens; the bottom stays clean so the film runs into the end card */
  .film-stage:global(.no-vignette)::after { display: none; }
  .film-stage::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgb(0 0 0 / 0.32), transparent 16%, transparent 84%, rgb(0 0 0 / 0.32)), linear-gradient(rgb(0 0 0 / 0.3), transparent 22%); }

  /* the clock you scroll: big, quiet, always there */
  .hud { position: absolute; z-index: 3; left: var(--gutter); top: clamp(5rem, 13vh, 7.5rem); margin: 0; display: flex; align-items: baseline; gap: 0.35em; padding: 0.35em 0.7em 0.4em; border-radius: 18px; font-family: var(--font-mono); color: var(--color-bg); background: rgb(22 21 24 / 0.62); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .film:not(.is-live) .hud { display: none; }
  .hud [data-hud-time] { font-size: clamp(2.5rem, 1.5rem + 4vw, 5.5rem); font-weight: 600; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; line-height: 1; }
  .hud-pm { font-size: clamp(0.9rem, 0.7rem + 0.6vw, 1.3rem); font-weight: 600; }
  .hud-where { color: #b9b6ad; margin-left: 0.6em; }
  .film-stage[data-shot='2'] .hud [data-hud-time] { color: var(--color-a-fill); }


  /* the headline is the title card at the end (and the whole story in the still version) */
  .subs {
    position: absolute; z-index: 3; left: var(--gutter); right: var(--gutter); bottom: clamp(5rem, 13vh, 7.5rem);
    margin: 0; max-width: none; font-size: clamp(2.25rem, 1rem + 4.6vw, 6rem); font-weight: 800; letter-spacing: -0.05em; line-height: 0.95;
    color: var(--color-bg); text-shadow: 0 2px 24px rgb(0 0 0 / 0.55); transition: opacity 600ms var(--ease-standard);
    color: color-mix(in srgb, #141414 calc(min(1, var(--out, 0) * 2.5) * 100%), var(--color-bg));
    text-shadow: 0 2px 24px rgb(0 0 0 / calc(0.55 * (1 - min(1, var(--out, 0) * 2.5))));
  }
  .subs .hand { color: color-mix(in srgb, var(--color-a) calc(min(1, var(--out, 0) * 2.5) * 100%), var(--color-a-fill)); }
  .subs .s1, .subs .s2 { display: block; }
  .film.is-live .subs { opacity: 0; }
  .film.is-live [data-shot='6'] .subs { opacity: 1; }
  .hand { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.01em; padding-inline: 0.04em; color: var(--color-a-fill); }
  .stop-a { color: var(--color-a-fill); }
  .stop-b { color: var(--color-b); }
  .subs .stop-b { color: #6f86ff; color: color-mix(in srgb, var(--color-b) calc(min(1, var(--out, 0) * 2.5) * 100%), #6f86ff); }
  /* on paper the hand stop is outlined in ink so it holds */
  .room .stop-a { -webkit-text-stroke: 0.035em var(--color-text); paint-order: stroke fill; }
  .status { position: absolute; z-index: 3; left: var(--gutter); right: var(--gutter); bottom: var(--space-6); margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); color: #b9b6ad; color: color-mix(in srgb, #4f4c45 calc(min(1, var(--out, 0) * 2.5) * 100%), #b9b6ad); }
  .film.is-live .status { opacity: 0; transition: opacity 600ms var(--ease-standard); }
  .film.is-live [data-shot='6'] .status { opacity: 1; }
  /* like a streaming player: the film never stands between someone and the work */
  .skip-film { position: absolute; z-index: 4; right: var(--gutter); bottom: var(--space-6); display: none; align-items: center; gap: 0.4em; min-height: 44px; padding: 0 1.1em; border-radius: 999px; color: var(--color-bg); text-decoration: none; font-size: var(--text-sm); font-weight: 650; background: rgb(22 21 24 / 0.62); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid rgb(255 255 255 / 0.18); }
  .film.is-live .skip-film { display: inline-flex; }
  .film.is-live [data-shot='6'] .skip-film { display: none; }
  @media (hover: hover) { .skip-film:hover { background: var(--color-bg); color: var(--color-text); } }
  .skip-film:focus-visible { outline: 3px solid var(--color-a-fill); outline-offset: 3px; }
  .live { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--color-a-fill); margin-right: 0.6em; vertical-align: 0.05em; }

  /* the end card: who, and how to start */
  .endcard { display: grid; gap: var(--space-8); align-items: end; padding-block: var(--space-16); }
  .endcard > * { min-width: 0; }
  .who-cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); margin: var(--space-6) 0 0; }
  .see { color: var(--color-text-muted); font-size: var(--text-sm); }
  .who { font-size: var(--t-lede); line-height: 1.35; letter-spacing: -0.015em; max-width: 26ch; margin: 0; }
