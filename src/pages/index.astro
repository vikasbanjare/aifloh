---
// Home, v4 (Oct 2026): the site as a small exhibition catalogue.
//   Fig. 1 is an original drawing of the brand idea: one line, drawn by hand (lime), finished by machine (cobalt).
//   Sections read like rooms; rows read like wall labels (title, medium, year). Free things are "Take one",
//   like the free prints at a gallery door. Few words, big type, lots of air.
// Rules kept: one type rule (DECISIONS.md), lime as fill/stroke only, works without JS, no style attributes (CSP).
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import Boot from '../components/Boot.astro';
import CodeWordBox from '../components/CodeWordBox.astro';
import InAppBanner from '../components/InAppBanner.astro';
import StandIn from '../components/StandIn.astro';
import Wall from '../components/Wall.astro';
import { loadContent, TYPE_LABEL } from '../lib/content';
import { href } from '../lib/href';

const P = JSON.parse(readFileSync(join(process.cwd(), 'content/portfolio.json'), 'utf8'));
const c = loadContent();

const byDate = [...c.resources].sort((a, b) => +new Date(b.date) - +new Date(a.date));
const freePicks = [...byDate.filter((r) => !r.standIn), ...byDate.filter((r) => r.standIn)].slice(0, 5);
const work = P.projects.slice(0, 6);
const STATUS: Record<string, string> = { live: 'Live', beta: 'Beta', 'private-beta': 'Private beta', 'in-development': 'In development', archived: 'Archived' };
const pad = (n: number) => String(n).padStart(2, '0');

// Fig. 1: the machine half of the line, snapped to a 40-unit grid.
const MACHINE = [[600, 200], [680, 200], [680, 120], [800, 120], [800, 280], [920, 280], [920, 160], [1040, 160], [1040, 240], [1160, 240]];
const machinePath = 'M' + MACHINE.map(([x, y]) => `${x} ${y}`).join(' L');
const dots: [number, number][] = [];
for (let x = 600; x <= 1180; x += 40) for (let y = 40; y <= 360; y += 40) dots.push([x, y]);
---
<Base title="Vikas Banjare" description="Vikas Banjare (Bubu): designer, editor and storyteller. Video, design, UI/UX and AI workflows. Founder of AI-Floh." intro>
  <Boot />
  <div class="wrap"><InAppBanner /></div>

  <section class="hero wrap" aria-labelledby="hero-h">
    <p class="status label rise">
      <span><span class="live" aria-hidden="true"></span>{P.profile.availability}</span>
      <span data-clock>India</span>
    </p>
    <h1 id="hero-h" class="display rise-2">
      <span class="l1">I keep the <span class="hand">craft</span><span class="stop-a">.</span></span>
      <span class="l2">I automate the&nbsp;grind<span class="stop-b">.</span></span>
    </h1>

    <figure class="fig1 rise-3">
      <svg viewBox="0 0 1200 380" role="img" aria-labelledby="fig1-cap">
        <g class="grid">{dots.map(([x, y]) => <circle cx={x} cy={y} r="1.6" />)}</g>
        <g class="ink"><circle cx="34" cy="246" r="11" /><circle cx="14" cy="268" r="3" /><circle cx="52" cy="276" r="2" /><circle cx="22" cy="222" r="2.2" /></g>
        <path class="by-hand" pathLength="1" d="M34 246 C 58 196, 84 292, 122 252 S 152 168, 198 212 C 230 244, 218 292, 188 278 C 160 264, 198 198, 250 214 S 316 306, 362 252 S 418 150, 472 206 S 552 262, 600 200" />
        <path class="by-machine" pathLength="1" d={machinePath} />
        <g class="nodes">{MACHINE.slice(1).map(([x, y], i) => <rect class={`nd nd${i}`} x={x - 5} y={y - 5} width="10" height="10" />)}</g>
      </svg>
      <div class="fig-tools" hidden>
        <button type="button" class="gbtn" data-draw aria-pressed="false"><span aria-hidden="true">✎</span> <span data-draw-label>Draw your own</span></button>
        <button type="button" class="gbtn gbtn-quiet" data-auto hidden>Draw for me</button>
        <p class="fig-status label" role="status" aria-live="polite"></p>
      </div>
      <figcaption id="fig1-cap" class="label">
        <span>Fig. 1</span>
        <span class="key"><i class="k k-a" aria-hidden="true"></i>Hand</span><span aria-hidden="true">→</span><span class="key"><i class="k k-b" aria-hidden="true"></i>Machine</span>
        <span class="visually-hidden">One line, drawn by hand and finished by machine.</span>
      </figcaption>
    </figure>

    <div class="hero-foot">
      <div class="who-wrap">
        <p class="who">Vikas Banjare, or Bubu. Designer, editor, storyteller. 8+&nbsp;years, 1000+&nbsp;projects.</p>
        <p class="who-cta"><a class="btn btn-primary" href={href('/contact/')} data-track="CTA Click" data-track-id="hero-talk">Start a project <span class="arrow" aria-hidden="true">→</span></a> <a class="see" href="#work">or see the work ↓</a></p>
      </div>
      <div class="cw-plate">
        <p class="note" aria-hidden="true">type the word here<svg viewBox="0 0 60 50" class="note-arrow"><path d="M4 4c10 2 26 10 34 22 4 6 6 12 7 18" /><path d="M36 38l9 7 6-11" /></svg></p>
        <CodeWordBox id="cw-home" />
      </div>
    </div>
  </section>

  <section class="room room-lime wrap" aria-labelledby="free-h">
    <h2 id="free-h" class="room-h"><span class="label n" aria-hidden="true">( 01 )</span> <span>Free<span class="stop-a">.</span></span></h2>
    <ol class="index" role="list">
      {freePicks.map((r, i) => (
        <li>
          <a class="ix" href={href(`/free/${r.slug}/`)}>
            <span class="ix-n label">{pad(i + 1)}</span>
            <span class="ix-t">{r.title} {r.standIn && <StandIn />}</span>
            <span class="ix-m label">{TYPE_LABEL[r.type]}</span>
            <span class="ix-w label">/{r.codeWord}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="more"><a class="btn btn-primary" href={href('/free/')}>All {c.resources.length} free <span class="arrow" aria-hidden="true">→</span></a></p>
  </section>

  <section class="room room-dark wrap" id="work" aria-labelledby="work-h">
    <h2 id="work-h" class="room-h"><span class="label n" aria-hidden="true">( 02 )</span> <span>Work<span class="stop-b">.</span></span></h2>
    <Wall items={P.projects} start={4} limit={6} />
    <p class="more"><a class="btn" href={P.profile.behance} rel="noopener">All {P.projects.length} on Behance <span class="arrow" aria-hidden="true">↗</span></a></p>
  </section>

  <section class="room wrap" aria-labelledby="studio-h">
    <h2 id="studio-h" class="room-h"><span class="label n" aria-hidden="true">( 03 )</span> <span>Studio<span class="stop-a">.</span></span></h2>
    <div class="pair">
      <a class="side side-a" href={href('/studio/')}>
        <span class="label"><i class="k k-a" aria-hidden="true"></i>Studio</span>
        <span class="side-t">We make it.</span>
        <span class="side-m">Video · Design · UI/UX</span>
      </a>
      <a class="side side-b" href={href('/studio/')}>
        <span class="label"><i class="k k-b" aria-hidden="true"></i>Automate</span>
        <span class="side-t">We build the machine.</span>
        <span class="side-m">Workflows · Plugins · Claude skills</span>
      </a>
    </div>
    <ol class="steps" role="list" aria-label="How a project runs">
      <li><span class="s-n" aria-hidden="true">01</span><b>Brief</b><span class="s-d">One call: what you need, who it is for, where it runs.</span></li>
      <li class="s-a"><span class="s-n" aria-hidden="true">02</span><b>Sketch by hand</b><span class="s-d">Storyboard, layout or flow before anything is generated.</span></li>
      <li class="s-b"><span class="s-n" aria-hidden="true">03</span><b>Make with AI</b><span class="s-d">People make the calls; AI and automation carry the repeats.</span></li>
      <li class="s-c"><span class="s-n" aria-hidden="true">04</span><b>Ship</b><span class="s-d">Files, sources and how it was made. No black boxes.</span></li>
    </ol>
  </section>

  <section class="room room-m room-blue wrap" aria-labelledby="built-h">
    <h2 id="built-h" class="room-h"><span class="label n" aria-hidden="true">( 04 )</span> <span>Tools<span class="stop-b">.</span></span></h2>
    <div class="built">
      <ol class="index" role="list">
        {c.tools.map((t, i) => (
          <li>
            <a class="ix" href={href(`/tools/${t.slug}/`)}>
              <span class="ix-n label">{pad(i + 1)}</span>
              <span class="ix-t">{t.title} {t.standIn && <StandIn />}</span>
              <span class="ix-m label">{t.platforms[0] ?? t.category}</span>
              <span class="ix-w label">{STATUS[t.status]}</span>
            </a>
          </li>
        ))}
      </ol>
      <figure class="plate">
        <img src={href('/media/portfolio/contentintel-site.webp')} alt="The ContentIntel website: a dark landing page reading Know it'll work before you hit publish" width="900" height="1347" loading="lazy" decoding="async" />
        <figcaption class="label">Fig. 2 · ContentIntel</figcaption>
      </figure>
    </div>
    <p class="more"><a class="btn" href={href('/tools/')}>Tools, lab and code <span class="arrow" aria-hidden="true">→</span></a></p>
  </section>

  <section class="room wrap" aria-labelledby="about-h">
    <h2 id="about-h" class="room-h"><span class="label n" aria-hidden="true">( 05 )</span> <span>About<span class="stop-a">.</span></span></h2>
    <div class="maker">
      <figure class="me">
        <img src={href(P.profile.photo)} alt={P.profile.name} width="230" height="230" loading="lazy" />
        <figcaption class="label">Fig. 3 · {P.profile.nickname}</figcaption>
      </figure>
      <div class="stats">
        <dl>
          {P.stats.map((s: any) => <div><dt class="label">{s.label}</dt><dd>{s.value}</dd></div>)}
        </dl>
        <a class="stat-more" href={href('/about/')}><span class="label">The person behind it</span><span class="sm-t">About me <span class="arrow" aria-hidden="true">→</span></span></a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { track } from '../scripts/track';

  // Fig. 1: try the 3D version once the hero is on screen. The SVG is the poster and the fallback.
  const fig = document.querySelector<HTMLElement>('.fig1');
  const svg = fig?.querySelector<SVGSVGElement>('svg');
  const report = (mode: string) => track('Hero Mode', { mode });
  if (fig && svg) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const gl = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();
    if (reduce) report('static-reduced-motion');
    else if (!gl) report('static-no-webgl');
    else {
      // Upgrade to 3D on the first sign of a person (move, scroll, touch, key) or after a quiet spell,
      // so the heavy script never competes with the first paint.
      let started = false;
      const go = async () => {
        if (started) return;
        started = true;
        EVENTS.forEach((ev) => removeEventListener(ev, go));
        const { mountFig3d } = await import('../scripts/fig3d');
        const m = mountFig3d(fig, svg, () => fig.classList.add('is-3d'), { instant: performance.now() > 2600 });
        // Probe: after 30 frames, a median above 28 ms means this device should keep the drawing.
        setTimeout(() => {
          const f = [...m.frameTimes].sort((a, b) => a - b);
          const median = f.length ? f[Math.floor(f.length / 2)] : 0;
          if (f.length >= 30 && median > 28) { m.dispose(); fig.classList.remove('is-3d'); report('static-low-power'); }
          else report('3d');
        }, 1800);
      };
      const EVENTS = ['pointermove', 'scroll', 'touchstart', 'keydown'] as const;
      EVENTS.forEach((ev) => addEventListener(ev, go, { passive: true, once: true }));
      const idle = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 1));
      setTimeout(() => idle(go, { timeout: 2000 }), 6000);
    }
  }

  // "Finish my line": an invitation to draw the hand half; the machine answers. Loaded on first click.
  const tools = document.querySelector<HTMLElement>('.fig-tools');
  if (fig && svg && tools) {
    tools.hidden = false;
    const btn = tools.querySelector<HTMLButtonElement>('[data-draw]')!;
    const label = tools.querySelector<HTMLElement>('[data-draw-label]')!;
    const auto = tools.querySelector<HTMLButtonElement>('[data-auto]')!;
    const status = tools.querySelector<HTMLElement>('.fig-status')!;
    let stop: (() => void) | null = null;
    btn.addEventListener('click', async () => {
      if (stop) { stop(); stop = null; btn.setAttribute('aria-pressed', 'false'); label.textContent = 'Draw your own'; auto.hidden = true; return; }
      const { startDrawing } = await import('../scripts/draw');
      stop = startDrawing(fig, svg, { status, auto });
      btn.setAttribute('aria-pressed', 'true');
      label.textContent = 'Back to Fig. 1';
      auto.hidden = false;
    });
  }

  const clocks = document.querySelectorAll<HTMLElement>('[data-clock]');
  const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata', hour12: false });
  const tick = () => clocks.forEach((el) => (el.textContent = `${fmt.format(new Date())} in India`));
  tick();
  setInterval(tick, 30000);

</script>

<style>
  /* ---------- hero ---------- */
  .hero { padding-block: var(--space-8) var(--space-16); }
  /* wide screens: the figure takes the stage, the actions stand beside it, all above the fold */
  @media (min-width: 72rem) {
    .hero { display: grid; grid-template-columns: minmax(0, 1fr) 24rem; column-gap: var(--space-12); align-items: center; }
    .hero > .status, .hero > h1 { grid-column: 1 / -1; }
    .hero > .fig1 { grid-column: 1; margin-top: var(--space-8); }
    .hero > .hero-foot { grid-column: 2; margin-top: var(--space-8); grid-template-columns: minmax(0, 1fr) !important; align-items: start; }
    .hero > .hero-foot .cw-plate { justify-self: stretch; }
    .hero > .hero-foot .note { display: none !important; }
  }
  .status { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-bottom: var(--space-12); color: var(--color-text-muted); }
  .live { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--color-a-fill); box-shadow: 0 0 0 1px var(--color-text); margin-right: 0.6em; vertical-align: 0.05em; }
  .display { font-size: var(--t-display); font-weight: 800; letter-spacing: -0.055em; line-height: 0.92; margin: 0; max-width: none; }
  .display .l1, .display .l2 { display: block; }
  .hand { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.02em; padding-inline: 0.04em; background: linear-gradient(transparent 62%, var(--color-a-fill) 62%, var(--color-a-fill) 88%, transparent 88%); }
  .stop-a { color: var(--color-a); }
  .stop-b { color: var(--color-b); }

  .fig1 { position: relative; margin: var(--space-12) 0 0; }
  .fig1 :global(.fig3d-canvas) { position: absolute; left: 0; top: 0; display: block; touch-action: pan-y; }
  .fig1.is-3d:not(.is-drawing) svg { visibility: hidden; }
  .fig1.is-drawing :global(.fig3d-canvas) { visibility: hidden; }
  .fig1.is-drawing .by-hand, .fig1.is-drawing .by-machine, .fig1.is-drawing .nodes, .fig1.is-drawing .ink { display: none; }
  .fig1.is-drawing svg { touch-action: none; }
  .fig1 :global(.draw-hit) { fill: transparent; }
  .fig1 :global(.draw-hand) { fill: none; stroke: var(--color-a-fill); stroke-width: 9; stroke-linecap: round; stroke-linejoin: round; pointer-events: none; }
  .fig1 :global(.draw-machine) { fill: none; stroke: var(--color-b); stroke-width: 3; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 900ms linear forwards; pointer-events: none; }
  .fig1 :global(.draw-hand-auto) { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 650ms cubic-bezier(0.45, 0, 0.2, 1) forwards; }
  .fig1 :global(.draw-node) { fill: var(--color-bg); stroke: var(--color-b); stroke-width: 2.5; opacity: 0; transform-box: fill-box; transform-origin: center; animation: pop 220ms var(--ease-standard) forwards; pointer-events: none; }
  @media (prefers-reduced-motion: reduce) { .fig1 :global(.draw-machine), .fig1 :global(.draw-hand-auto) { stroke-dashoffset: 0; } .fig1 :global(.draw-node) { opacity: 1; } }
  .fig-tools { position: absolute; left: 0; top: 0; z-index: 2; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
  .gbtn {
    display: inline-flex; align-items: center; gap: var(--space-2); min-height: 40px; padding: 0 var(--space-4); border-radius: 999px;
    background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1px solid var(--glass-edge); box-shadow: var(--glass-shadow);
    font: inherit; font-size: var(--text-sm); font-weight: 650; color: var(--color-text); cursor: pointer; transition: transform 160ms var(--ease-standard);
  }
  .gbtn[aria-pressed='true'] { background: var(--color-text); color: var(--color-bg); border-color: var(--color-text); }
  .gbtn:active { transform: scale(0.96); }
  .gbtn-quiet { font-weight: 500; }
  .fig-status { margin: 0; color: var(--color-text-muted); max-width: 30ch; }
  @media (max-width: 47.99rem) { .fig-tools { position: static; margin-bottom: var(--space-4); } }
  .fig1 svg { display: block; width: 100%; height: auto; overflow: visible; }
  .grid circle { fill: var(--color-line-strong); }
  .ink circle { fill: var(--color-a-fill); }
  .by-hand { fill: none; stroke: var(--color-a-fill); stroke-width: 9; stroke-linecap: round; stroke-linejoin: round; }
  .by-machine { fill: none; stroke: var(--color-b); stroke-width: 3; stroke-linejoin: miter; }
  .nd { fill: var(--color-bg); stroke: var(--color-b); stroke-width: 2.5; }
  .fig1 figcaption { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin-top: var(--space-4); padding-top: var(--space-3); border-top: 1px solid var(--color-text); color: var(--color-text-muted); }
  .k { display: inline-block; width: 0.9em; height: 0.9em; margin-right: 0.45em; vertical-align: -0.1em; border: 1px solid var(--color-text); }
  .k-a { background: var(--color-a-fill); }
  .k-b { background: var(--color-b); }
  .key { white-space: nowrap; }

  @media (prefers-reduced-motion: no-preference) {
    .by-hand, .by-machine { stroke-dasharray: 1; stroke-dashoffset: 1; }
    .by-hand { animation: draw 1100ms cubic-bezier(0.45, 0, 0.2, 1) 450ms forwards; }
    .by-machine { animation: draw 900ms linear 1500ms forwards; }
    .nd { opacity: 0; transform-box: fill-box; transform-origin: center; animation: pop 220ms var(--ease-standard) forwards; }
    .nd0 { animation-delay: 1560ms; } .nd1 { animation-delay: 1640ms; } .nd2 { animation-delay: 1740ms; }
    .nd3 { animation-delay: 1840ms; } .nd4 { animation-delay: 1960ms; } .nd5 { animation-delay: 2060ms; }
    .nd6 { animation-delay: 2160ms; } .nd7 { animation-delay: 2260ms; } .nd8 { animation-delay: 2380ms; }
    :global(html.booting) .by-hand, :global(html.booting) .by-machine, :global(html.booting) .nd { animation-play-state: paused; }
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes pop { from { opacity: 0; transform: scale(0); } to { opacity: 1; transform: none; } }

  .hero-foot { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-8); margin-top: var(--space-12); align-items: end; }
  .hero-foot > * { min-width: 0; }
  .who-cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); margin: var(--space-6) 0 0; }
  .see { color: var(--color-text-muted); font-size: var(--text-sm); }
  .who { font-size: var(--t-lede); line-height: 1.35; letter-spacing: -0.015em; max-width: 24ch; margin: 0; }
  .cw-plate { position: relative; border: 1px solid var(--color-text); background: var(--color-surface); padding: var(--space-6); max-width: min(30rem, calc(100% - 6px)); box-shadow: 6px 6px 0 var(--color-text); }
  .note { display: none; }
  @media (min-width: 56rem) {
    .hero-foot { grid-template-columns: 1fr minmax(0, 28rem); }
    .cw-plate { justify-self: end; width: 100%; }
  }
  @media (min-width: 72rem) {
    .note {
      display: block; position: absolute; right: calc(100% + 1.5rem); top: 0; width: 10rem; margin: 0;
      font-family: var(--font-serif); font-style: italic; font-size: 1.5rem; line-height: 1.05; color: var(--color-b); text-align: right; transform: rotate(-5deg);
    }
    .note-arrow { position: absolute; right: -2.8rem; top: 1rem; width: 3rem; height: 2.5rem; overflow: visible; }
    .note-arrow path { fill: none; stroke: var(--color-b); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  }

  /* ---------- rooms ---------- */
  .room { padding-block: var(--space-16); background: linear-gradient(var(--color-text), var(--color-text)) top center / calc(100% - 2 * var(--gutter)) 1px no-repeat; }
  .room-h { display: flex; align-items: baseline; gap: var(--space-4); font-size: clamp(2.75rem, 1rem + 6.4vw, 7.5rem); font-weight: 800; letter-spacing: -0.055em; line-height: 0.9; margin: 0 0 var(--space-12); }
  .room-h .n { align-self: flex-start; margin-top: 0.6em; }
  .room-h .n { color: var(--color-b); letter-spacing: 0.06em; font-weight: 500; }

  .more { margin: var(--space-8) 0 0; }
  /* ---------- the margin ledger: one thread down the page. Hand (lime wobble) through most rooms,
     machine (straight cobalt) through Tools. Drawn by scroll where supported; simply there elsewhere. ---------- */
  @media (min-width: 64rem) {
    .room { position: relative; }
    .room::before {
      content: ''; position: absolute; left: calc(var(--gutter) * 0.25 - 10px); top: 0; bottom: 0; width: 20px;
      background: url("data:image/svg+xml;base64,") repeat-y center top / 20px 160px; pointer-events: none;
    }
    .room-m::before { background: linear-gradient(var(--color-b), var(--color-b)) center top / 3px 100% no-repeat; }
    .room::after {
      content: ''; position: absolute; left: calc(var(--gutter) * 0.25 - 6px); top: calc(var(--space-16) + 0.45em); width: 12px; height: 12px;
      background: var(--color-bg); border: 2px solid var(--color-text); pointer-events: none;
    }
    .room-m::after { border-color: var(--color-b); }
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .room::before { transform-origin: top; animation: thread linear both; animation-timeline: view(); animation-range: entry 20% cover 55%; }
      }
    }
  }
  @keyframes thread { from { transform: scaleY(0); } to { transform: scaleY(1); } }


  /* ---------- index rows: wall labels ---------- */
  .index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-line-strong); }
