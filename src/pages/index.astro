---
// Home, v4 (Oct 2026): the site as a small exhibition catalogue.
//   Fig. 1 is an original drawing of the brand idea: one line, drawn by hand (lime), finished by machine (cobalt).
//   Sections read like rooms; rows read like wall labels (title, medium, year). Free things are "Take one",
//   like the free prints at a gallery door. Few words, big type, lots of air.
// Rules kept: one type rule (DECISIONS.md), lime as fill/stroke only, works without JS, no style attributes (CSP).
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import Boot from '../components/Boot.astro';
import CodeWordBox from '../components/CodeWordBox.astro';
import InAppBanner from '../components/InAppBanner.astro';
import StandIn from '../components/StandIn.astro';
import { loadContent, TYPE_LABEL } from '../lib/content';
import { href } from '../lib/href';

const P = JSON.parse(readFileSync(join(process.cwd(), 'content/portfolio.json'), 'utf8'));
const c = loadContent();

const byDate = [...c.resources].sort((a, b) => +new Date(b.date) - +new Date(a.date));
const freePicks = [...byDate.filter((r) => !r.standIn), ...byDate.filter((r) => r.standIn)].slice(0, 5);
const work = P.projects.slice(0, 6);
const STATUS: Record<string, string> = { live: 'Live', beta: 'Beta', 'private-beta': 'Private beta', 'in-development': 'In development', archived: 'Archived' };
const pad = (n: number) => String(n).padStart(2, '0');

// Fig. 1: the machine half of the line, snapped to a 40-unit grid.
const MACHINE = [[600, 200], [680, 200], [680, 120], [800, 120], [800, 280], [920, 280], [920, 160], [1040, 160], [1040, 240], [1160, 240]];
const machinePath = 'M' + MACHINE.map(([x, y]) => `${x} ${y}`).join(' L');
const dots: [number, number][] = [];
for (let x = 600; x <= 1180; x += 40) for (let y = 40; y <= 360; y += 40) dots.push([x, y]);
---
<Base title="Vikas Banjare" description="Vikas Banjare (Bubu): designer, editor and storyteller. Video, design, UI/UX and AI workflows. Founder of AI-Floh." intro>
  <Boot />
  <div class="wrap"><InAppBanner /></div>

  <section class="hero wrap" aria-labelledby="hero-h">
    <p class="status label rise">
      <span><span class="live" aria-hidden="true"></span>{P.profile.availability}</span>
      <span data-clock>India</span>
    </p>
    <h1 id="hero-h" class="display rise-2">
      <span class="l1">I keep the <span class="hand">craft</span><span class="stop-a">.</span></span>
      <span class="l2">I automate the&nbsp;grind<span class="stop-b">.</span></span>
    </h1>

    <figure class="fig1 rise-3">
      <svg viewBox="0 0 1200 380" role="img" aria-labelledby="fig1-cap">
        <g class="grid">{dots.map(([x, y]) => <circle cx={x} cy={y} r="1.6" />)}</g>
        <g class="ink"><circle cx="34" cy="246" r="11" /><circle cx="14" cy="268" r="3" /><circle cx="52" cy="276" r="2" /><circle cx="22" cy="222" r="2.2" /></g>
        <path class="by-hand" pathLength="1" d="M34 246 C 58 196, 84 292, 122 252 S 152 168, 198 212 C 230 244, 218 292, 188 278 C 160 264, 198 198, 250 214 S 316 306, 362 252 S 418 150, 472 206 S 552 262, 600 200" />
        <path class="by-machine" pathLength="1" d={machinePath} />
        <g class="nodes">{MACHINE.slice(1).map(([x, y], i) => <rect class={`nd nd${i}`} x={x - 5} y={y - 5} width="10" height="10" />)}</g>
      </svg>
      <figcaption id="fig1-cap" class="label">
        <span>Fig. 1</span>
        <span>One line. <i class="k k-a" aria-hidden="true"></i>Drawn by hand, <i class="k k-b" aria-hidden="true"></i>finished by machine.</span>
      </figcaption>
    </figure>

    <div class="hero-foot">
      <p class="who">Vikas Banjare, or Bubu. Designer, editor, storyteller. 8+&nbsp;years, 1000+&nbsp;projects.</p>
      <div class="cw-plate">
        <p class="note" aria-hidden="true">type the word here<svg viewBox="0 0 60 50" class="note-arrow"><path d="M4 4c10 2 26 10 34 22 4 6 6 12 7 18" /><path d="M36 38l9 7 6-11" /></svg></p>
        <CodeWordBox id="cw-home" />
      </div>
    </div>
  </section>

  <section class="room wrap" aria-labelledby="free-h">
    <h2 id="free-h" class="room-h"><span class="label n">( 01 )</span> <span>Free<span class="stop-a">.</span></span></h2>
    <ol class="index" role="list">
      {freePicks.map((r, i) => (
        <li>
          <a class="ix" href={href(`/free/${r.slug}/`)}>
            <span class="ix-n label">{pad(i + 1)}</span>
            <span class="ix-t">{r.title} {r.standIn && <StandIn />}</span>
            <span class="ix-m label">{TYPE_LABEL[r.type]}</span>
            <span class="ix-w label">/{r.codeWord}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="more"><a class="btn btn-primary" href={href('/free/')}>All {c.resources.length} free <span class="arrow" aria-hidden="true">→</span></a></p>
  </section>

  <section class="room wrap" id="work" aria-labelledby="work-h">
    <h2 id="work-h" class="room-h"><span class="label n">( 02 )</span> <span>Work<span class="stop-b">.</span></span></h2>
    <ol class="index index-big" role="list" data-work>
      {work.map((w: any, i: number) => (
        <li>
          <a class="ix" href={w.link} rel="noopener" data-cover={w.cover ? href(w.cover) : undefined}>
            <span class="ix-n label">{pad(i + 1)}</span>
            <span class="ix-t">{w.title}</span>
            <span class="ix-m label">{w.tags.join(', ')}</span>
            <span class="ix-w label">{w.year}</span>
          </a>
        </li>
      ))}
    </ol>
    <img class="w-float" alt="" width="360" height="240" hidden decoding="async" />
    <p class="more"><a class="btn" href={P.profile.behance} rel="noopener">All {P.projects.length} on Behance <span class="arrow" aria-hidden="true">↗</span></a></p>
  </section>

  <section class="room wrap" aria-labelledby="studio-h">
    <h2 id="studio-h" class="room-h"><span class="label n">( 03 )</span> <span>Studio<span class="stop-a">.</span></span></h2>
    <div class="pair">
      <a class="side side-a" href={href('/studio/')}>
        <span class="label"><i class="k k-a" aria-hidden="true"></i>Studio</span>
        <span class="side-t">We make it.</span>
        <span class="side-m">Video · Design · UI/UX</span>
      </a>
      <a class="side side-b" href={href('/studio/')}>
        <span class="label"><i class="k k-b" aria-hidden="true"></i>Automate</span>
        <span class="side-t">We build the machine.</span>
        <span class="side-m">Workflows · Plugins · Claude skills</span>
      </a>
    </div>
    <ol class="steps label" role="list" aria-label="How a project runs">
      <li>Brief</li><li class="s-a">Sketch by hand</li><li class="s-b">Make with AI</li><li>Ship</li>
    </ol>
  </section>

  <section class="room wrap" aria-labelledby="built-h">
    <h2 id="built-h" class="room-h"><span class="label n">( 04 )</span> <span>Tools<span class="stop-b">.</span></span></h2>
    <div class="built">
      <ol class="index" role="list">
        {c.tools.map((t, i) => (
          <li>
            <a class="ix" href={href(`/tools/${t.slug}/`)}>
              <span class="ix-n label">{pad(i + 1)}</span>
              <span class="ix-t">{t.title} {t.standIn && <StandIn />}</span>
              <span class="ix-m label">{t.platforms[0] ?? t.category}</span>
              <span class="ix-w label">{STATUS[t.status]}</span>
            </a>
          </li>
        ))}
      </ol>
      <figure class="plate">
        <img src={href('/media/portfolio/contentintel-site.webp')} alt="The ContentIntel website: a dark landing page reading Know it'll work before you hit publish" width="900" height="1347" loading="lazy" decoding="async" />
        <figcaption class="label">Fig. 2 · ContentIntel</figcaption>
      </figure>
    </div>
    <p class="more"><a class="btn" href={href('/tools/')}>Tools, lab and code <span class="arrow" aria-hidden="true">→</span></a></p>
  </section>

  <section class="room wrap" aria-labelledby="about-h">
    <h2 id="about-h" class="room-h"><span class="label n">( 05 )</span> <span>About<span class="stop-a">.</span></span></h2>
    <div class="maker">
      <figure class="me">
        <img src={href(P.profile.photo)} alt={P.profile.name} width="230" height="230" loading="lazy" />
        <figcaption class="label">Fig. 3 · {P.profile.nickname}</figcaption>
      </figure>
      <dl class="stats">
        {P.stats.map((s: any) => <div><dt class="label">{s.label}</dt><dd>{s.value}</dd></div>)}
      </dl>
    </div>
    <p class="more"><a class="btn" href={href('/about/')}>About me <span class="arrow" aria-hidden="true">→</span></a></p>
  </section>
</Base>

<script>
  const clocks = document.querySelectorAll<HTMLElement>('[data-clock]');
  const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata', hour12: false });
  const tick = () => clocks.forEach((el) => (el.textContent = `${fmt.format(new Date())} in India`));
  tick();
  setInterval(tick, 30000);

  const list = document.querySelector<HTMLElement>('[data-work]');
  const float = document.querySelector<HTMLImageElement>('.w-float');
  if (list && float && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let x = 0, y = 0, raf = 0;
    const move = () => { raf = 0; float.style.transform = `translate(${x}px, ${y}px)`; };
    list.addEventListener('pointermove', (e) => {
      const src = (e.target as HTMLElement).closest<HTMLElement>('.ix')?.dataset.cover;
      if (src) { if (float.getAttribute('src') !== src) float.src = src; float.hidden = false; } else float.hidden = true;
      x = e.clientX + 28; y = e.clientY - 120;
      if (!raf) raf = requestAnimationFrame(move);
    });
    list.addEventListener('pointerleave', () => (float.hidden = true));
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero { padding-block: var(--space-8) var(--space-16); }
  .status { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-bottom: var(--space-12); color: var(--color-text-muted); }
  .live { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--color-a-fill); box-shadow: 0 0 0 1px var(--color-text); margin-right: 0.6em; vertical-align: 0.05em; }
  .display { font-size: var(--t-display); font-weight: 800; letter-spacing: -0.055em; line-height: 0.92; margin: 0; max-width: none; }
  .display .l1, .display .l2 { display: block; }
  .hand { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.02em; padding-inline: 0.04em; background: linear-gradient(transparent 62%, var(--color-a-fill) 62%, var(--color-a-fill) 88%, transparent 88%); }
  .stop-a { color: var(--color-a); }
  .stop-b { color: var(--color-b); }

  .fig1 { margin: var(--space-12) 0 0; }
  .fig1 svg { display: block; width: 100%; height: auto; overflow: visible; }
  .grid circle { fill: var(--color-line-strong); }
  .ink circle { fill: var(--color-a-fill); }
  .by-hand { fill: none; stroke: var(--color-a-fill); stroke-width: 9; stroke-linecap: round; stroke-linejoin: round; }
  .by-machine { fill: none; stroke: var(--color-b); stroke-width: 3; stroke-linejoin: miter; }
  .nd { fill: var(--color-bg); stroke: var(--color-b); stroke-width: 2.5; }
  .fig1 figcaption { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-top: var(--space-4); padding-top: var(--space-3); border-top: 1px solid var(--color-text); color: var(--color-text-muted); }
  .k { display: inline-block; width: 0.9em; height: 0.9em; margin-right: 0.45em; vertical-align: -0.1em; border: 1px solid var(--color-text); }
  .k-a { background: var(--color-a-fill); }
  .k-b { background: var(--color-b); margin-left: 0.2em; }

  @media (prefers-reduced-motion: no-preference) {
    .by-hand, .by-machine { stroke-dasharray: 1; stroke-dashoffset: 1; }
    .by-hand { animation: draw 1100ms cubic-bezier(0.45, 0, 0.2, 1) 450ms forwards; }
    .by-machine { animation: draw 900ms linear 1500ms forwards; }
    .nd { opacity: 0; transform-box: fill-box; transform-origin: center; animation: pop 220ms var(--ease-standard) forwards; }
    .nd0 { animation-delay: 1560ms; } .nd1 { animation-delay: 1640ms; } .nd2 { animation-delay: 1740ms; }
    .nd3 { animation-delay: 1840ms; } .nd4 { animation-delay: 1960ms; } .nd5 { animation-delay: 2060ms; }
    .nd6 { animation-delay: 2160ms; } .nd7 { animation-delay: 2260ms; } .nd8 { animation-delay: 2380ms; }
    :global(html.booting) .by-hand, :global(html.booting) .by-machine, :global(html.booting) .nd { animation-play-state: paused; }
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes pop { from { opacity: 0; transform: scale(0); } to { opacity: 1; transform: none; } }

  .hero-foot { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-8); margin-top: var(--space-12); align-items: end; }
  .hero-foot > * { min-width: 0; }
  .who { font-size: var(--t-lede); line-height: 1.35; letter-spacing: -0.015em; max-width: 24ch; margin: 0; }
  .cw-plate { position: relative; border: 1px solid var(--color-text); background: var(--color-surface); padding: var(--space-6); max-width: min(30rem, calc(100% - 6px)); box-shadow: 6px 6px 0 var(--color-text); }
  .note { display: none; }
  @media (min-width: 56rem) {
    .hero-foot { grid-template-columns: 1fr minmax(0, 28rem); }
    .cw-plate { justify-self: end; width: 100%; }
  }
  @media (min-width: 72rem) {
    .note {
      display: block; position: absolute; right: calc(100% + 1.5rem); top: 0; width: 10rem; margin: 0;
      font-family: var(--font-serif); font-style: italic; font-size: 1.5rem; line-height: 1.05; color: var(--color-b); text-align: right; transform: rotate(-5deg);
    }
    .note-arrow { position: absolute; right: -2.8rem; top: 1rem; width: 3rem; height: 2.5rem; overflow: visible; }
    .note-arrow path { fill: none; stroke: var(--color-b); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  }

  /* ---------- rooms ---------- */
  .room { padding-block: var(--space-16); background: linear-gradient(var(--color-text), var(--color-text)) top center / calc(100% - 2 * var(--gutter)) 1px no-repeat; }
  .room-h { display: flex; align-items: baseline; gap: var(--space-4); font-size: var(--t-row); font-weight: 800; letter-spacing: -0.045em; line-height: 1; margin: 0 0 var(--space-8); }
  .room-h .n { color: var(--color-b); letter-spacing: 0.06em; font-weight: 500; }
  @media (min-width: 64rem) {
    .room { display: grid; grid-template-columns: 15rem minmax(0, 1fr); column-gap: var(--space-8); }
    .room > * { grid-column: 2; }
    .room > .room-h { grid-column: 1 / -1; display: grid; grid-template-columns: 15rem minmax(0, 1fr); column-gap: var(--space-8); }
    .room > .w-float { grid-column: auto; }
  }
  .more { margin: var(--space-8) 0 0; }

  /* ---------- index rows: wall labels ---------- */
  .index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-line-strong); }
  .index li { border-bottom: 1px solid var(--color-line-strong); }
  .ix {
    position: relative; display: grid; grid-template-columns: 2.25rem minmax(0, 1fr) auto; column-gap: var(--space-3); row-gap: var(--space-1);
    align-items: baseline; padding: var(--space-4) 0; text-decoration: none; isolation: isolate;
  }
  .ix-n { color: var(--color-text-muted); grid-row: 1 / span 2; }
  .ix-t { font-weight: 650; font-size: var(--t-body); letter-spacing: -0.01em; }
  .ix-m { grid-column: 2; color: var(--color-text-muted); }
  .ix-w { grid-column: 3; grid-row: 1; color: var(--color-text-muted); }
  @media (min-width: 48rem) {
    .ix { grid-template-columns: 3rem minmax(0, 1fr) 13rem 6.5rem; padding: var(--space-6) 0; }
    .ix-n, .ix-m, .ix-w { grid-row: 1; }
    .ix-m { grid-column: 3; }
    .ix-w { grid-column: 4; text-align: right; }
    .ix-t { font-size: var(--t-row-sm); font-weight: 700; letter-spacing: -0.03em; }
    .index-big .ix-t { font-size: var(--t-row); font-weight: 800; letter-spacing: -0.045em; line-height: 1; }
  }
  .ix::before { content: ''; position: absolute; inset: 0 -0.75rem; z-index: -1; background: var(--color-a-fill); transform: scaleX(0); transform-origin: left; transition: transform 240ms var(--ease-standard); }
  @media (hover: hover) { .ix:hover::before { transform: scaleX(1); } .ix:hover .ix-n, .ix:hover .ix-m, .ix:hover .ix-w { color: var(--color-text); } }
  .ix:focus-visible::before { transform: scaleX(1); }
  .w-float { position: fixed; left: 0; top: 0; z-index: 60; width: 300px; height: auto; pointer-events: none; border: 1px solid var(--color-text); box-shadow: 6px 6px 0 var(--color-text); }

  /* ---------- commissions ---------- */
  .pair { display: grid; gap: var(--space-4); }
  @media (min-width: 48rem) { .pair { grid-template-columns: 1fr 1fr; } }
  .side { display: flex; flex-direction: column; gap: var(--space-2); min-height: 15rem; padding: var(--space-6); border: 1px solid var(--color-text); text-decoration: none; transition: transform 200ms var(--ease-standard), box-shadow 200ms var(--ease-standard); }
  .side-a { background: var(--color-a-fill); color: var(--color-a-ink); }
  .side-b { background: var(--color-b); color: var(--color-b-ink); }
  .side-b .k { border-color: var(--color-b-ink); background: var(--color-b-ink); }
  .side-t { font-size: var(--t-row); font-weight: 800; letter-spacing: -0.045em; line-height: 0.98; margin-top: auto; }
  .side .label { color: inherit; }
  .side-m { font-size: var(--text-sm); }
  @media (hover: hover) { .side:hover { transform: translate(-4px, -4px); box-shadow: 6px 6px 0 var(--color-text); } }
  .steps { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; margin: var(--space-6) 0 0; padding: 0; counter-reset: s; }
  .steps li { counter-increment: s; display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-3); border: 1px solid var(--color-text); }
  .steps li::before { content: counter(s, decimal-leading-zero); color: var(--color-text-muted); }
  .s-a { background: var(--color-a-fill); }
  .s-b { background: var(--color-b); color: var(--color-b-ink); }
  .s-b::before { color: var(--color-b-ink) !important; opacity: 0.8; }

  /* ---------- instruments ---------- */
  .built { display: grid; gap: var(--space-8); }
  .plate { margin: 0; border: 1px solid var(--color-text); background: var(--color-surface); }
  .plate img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; }
  .plate figcaption { padding: var(--space-2) var(--space-3); border-top: 1px solid var(--color-text); }
  @media (min-width: 64rem) { .built { grid-template-columns: minmax(0, 1fr) 14rem; align-items: start; } .built .ix { grid-template-columns: 3rem minmax(0, 1fr) 8.5rem 6.5rem; } }
  @media (max-width: 63.99rem) { .plate { display: none; } }

  /* ---------- the maker ---------- */
  .maker { display: grid; gap: var(--space-8); }
  @media (min-width: 48rem) { .maker { grid-template-columns: 12rem minmax(0, 1fr); align-items: start; } }
  .me { margin: 0; border: 1px solid var(--color-text); background: var(--color-surface); max-width: 12rem; transform: rotate(-2deg); box-shadow: 6px 6px 0 var(--color-text); }
  .me img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; }
  .me figcaption { padding: var(--space-2) var(--space-3); border-top: 1px solid var(--color-text); }
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; border-top: 1px solid var(--color-line-strong); }
  .stats div { padding: var(--space-4) var(--space-4) var(--space-4) 0; border-bottom: 1px solid var(--color-line-strong); display: flex; flex-direction: column-reverse; gap: var(--space-1); }
  .stats dt { color: var(--color-text-muted); }
  .stats dd { margin: 0; font-size: var(--t-row); font-weight: 800; letter-spacing: -0.05em; line-height: 1; }
  @media (min-width: 64rem) { .stats { grid-template-columns: repeat(3, 1fr); } }
</style>
