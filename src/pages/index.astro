---
// Personal brand home: Vikas Banjare. Content lives in content/portfolio.json.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import CraftStack from '../components/CraftStack.astro';
import { loadContent } from '../lib/content';
import { href } from '../lib/href';

const P = JSON.parse(readFileSync(join(process.cwd(), 'content/portfolio.json'), 'utf8'));
const c = loadContent();
const skills = c.resources.filter((r) => r.type === 'skill').length;
const contentintel = c.tools.find((t) => t.slug === 'contentintel');
const captions = c.tools.find((t) => t.slug === 'cutpilot-caption-studio');

// Pixel mosaic for the process section, seeded so every build looks the same.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const cells = Array.from({ length: 10 * 6 }, () => {
  const r = rnd();
  return r < 0.12 ? 'px-a' : r < 0.2 ? 'px-b' : r < 0.45 ? 'px-2' : r < 0.7 ? 'px-1' : 'px-0';
});
const steps = [
  { n: 'I', title: 'Idea', body: 'A short call about what you need, who it is for and where it will run.', tags: ['Intro call', 'Brief', 'Plan'] },
  { n: 'II', title: 'Make', body: 'Sketch and decide by hand. Let AI and automation carry the repetitive parts.', tags: ['Design', 'Edit', 'Motion'] },
  { n: 'III', title: 'Launch', body: 'Ship it with the files, the sources and how it was made. Then iterate.', tags: ['Delivery', 'Variants', 'Support'] },
];
---
<Base title="Vikas Banjare" description="Vikas Banjare (Bubu): designer, editor and storyteller. Video, design, UI/UX and AI workflows. Founder of AI-Floh.">
  <!-- HERO -->
  <section class="hero wrap">
    <div class="hero-top">
      <p class="logo rise" aria-label="Vikas Banjare">vikas<em class="s">banjare</em></p>
      <div class="hero-meta rise-2">
        <img src={href(P.profile.photo)} alt="" width="40" height="40" class="avatar" />
        <p>{P.stats[0].value} {P.stats[0].label},<br />{P.stats[1].value} {P.stats[1].label}</p>
      </div>
    </div>
    <h1 class="statement rise-2">
      Video, design <em class="s">&amp;</em> AI&nbsp;workflows<span class="dim">, made by hand and sped up where it doesn't cost the craft.</span>
    </h1>
    <p class="hero-cta rise-3">
      <a class="btn btn-primary" href="#work">See the work <span class="arrow" aria-hidden="true">↓</span></a>
      <a class="btn" href={href('/contact/')} data-track="CTA Click" data-track-id="home-talk">Start a project</a>
      <span class="avail"><span class="pulse" aria-hidden="true" />{P.profile.availability}</span>
    </p>
  </section>

  <!-- INTRO PANEL -->
  <section class="panel" aria-labelledby="intro-name">
    <div class="wrap">
      <div class="intro-head reveal">
        <img src={href(P.profile.photo)} alt={`${P.profile.name}`} width="72" height="72" class="avatar-lg" />
        <div>
          <p id="intro-name" class="intro-name">{P.profile.name} <span class="muted">· {P.profile.nickname}</span></p>
          <p class="muted intro-roles">{P.profile.roles}</p>
        </div>
      </div>
      <ul class="cards3" role="list">
        <li class="card3 reveal">
          <div class="vis vis-stack"><CraftStack /></div>
          <p>Every piece is built in layers. I show which ones were made <span class="a">by hand</span> and which were <span class="b">automated</span>.</p>
        </li>
        <li class="card3 reveal">
          <div class="vis vis-toggle" aria-hidden="true">
            <span class="tg"><span class="tg-knob">CRAFT</span><span class="tg-ai">AI ✦</span></span>
          </div>
          <p>I use AI where it speeds things up, never where it costs the quality.</p>
        </li>
        <li class="card3 reveal">
          <div class="vis vis-word" aria-hidden="true">
            <span class="term"><span class="muted">yoursite.com/</span><span class="a">hooks</span><span class="caret" /></span>
          </div>
          <p>Every post ends with a word. Type it on this site and get the prompt, skill or template, free.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- WORK -->
  <section class="wrap section" id="work" aria-labelledby="work-h">
    <div class="sec-top reveal">
      <h2 id="work-h" class="h-sec">Selected <em class="s">work</em></h2>
      <a class="all" href={P.profile.behance} rel="me noopener">All projects on Behance <span class="plus" aria-hidden="true">+</span></a>
    </div>
    <ol class="work" role="list" data-work>
      {P.projects.map((p: any, i: number) => (
        <li class="w-row reveal" data-cover={p.cover ? href(p.cover) : undefined}>
          <a href={p.link} rel="noopener">
            <span class="w-n">{String(i + 1).padStart(3, '0')} /</span>
            <span class="w-tags">{p.tags.map((t: string) => <span>{t}</span>)}</span>
            <span class="w-year">{p.year}</span>
            <span class="w-title">{p.title}</span>
            <span class="w-sum muted">{p.summary}</span>
            <span class="w-go" aria-hidden="true">↗</span>
            {p.cover && <img class="w-thumb" src={href(p.cover)} alt={p.coverAlt} loading="lazy" width="600" height="400" />}
          </a>
        </li>
      ))}
    </ol>
    <img class="w-float" alt="" aria-hidden="true" hidden />
  </section>

  <!-- NUMBERS -->
  <section class="wrap section numbers" aria-label="In numbers">
    <ul class="stats" role="list">
      {P.stats.map((s: any) => <li class="reveal"><span class="st-v">{s.value}</span><span class="st-l muted">{s.label}</span></li>)}
    </ul>
  </section>

  <!-- PROCESS -->
  <section class="process" aria-labelledby="proc-h">
    <div class="mosaic" aria-hidden="true">{cells.map((k) => <i class={k} />)}</div>
    <div class="wrap proc-inner">
      <h2 id="proc-h" class="h-sec reveal">Idea <span class="dim">→</span> Make <span class="dim">→</span> <em class="s">Launch</em></h2>
      <ol class="steps" role="list">
        {steps.map((s) => (
          <li class="step reveal">
            <span class="st-n serif">{s.n}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.body}</p>
            <p class="chips">{s.tags.map((t) => <span class="tag">{t}</span>)}</p>
          </li>
        ))}
      </ol>
      <p class="aside reveal"><span class="paren">(</span> From a rough idea to a finished, shipped piece, without extra steps in between. <span class="paren">)</span></p>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="wrap section" aria-labelledby="svc-h">
    <div class="sec-top reveal">
      <h2 id="svc-h" class="h-sec">What I <em class="s">do</em></h2>
      <a class="all" href={href('/studio/')}>Work with AI-Floh <span class="plus" aria-hidden="true">+</span></a>
    </div>
    <ul class="svc" role="list">
      {P.services.map((s: any, i: number) => (
        <li class="svc-row reveal">
          <span class="svc-n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p class="muted">{s.summary}</p>
          <p class="chips">{s.tags.map((t: string) => <span class="tag">{t}</span>)}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- BUILT -->
  <section class="panel" aria-labelledby="built-h">
    <div class="wrap section">
      <h2 id="built-h" class="h-sec reveal">Things I <em class="s">built</em></h2>
      <ul class="built" role="list">
        {contentintel && (
          <li class="b-card reveal">
            <img src={href('/media/portfolio/contentintel-site.webp')} alt="The ContentIntel website" width="900" height="1347" loading="lazy" decoding="async" />
            <div><p class="chip-status">Live · web app</p><h3>{contentintel.title}</h3><p class="muted">{contentintel.summary}</p><a class="btn" href={href('/tools/contentintel/')}>About the tool <span class="arrow" aria-hidden="true">→</span></a></div>
          </li>
        )}
        {captions && (
          <li class="b-card b-text reveal">
            <div><p class="chip-status">Beta · in the browser</p><h3>{captions.title}</h3><p class="muted">{captions.summary}</p><a class="btn" href={href('/tools/cutpilot-caption-studio/')}>About the tool <span class="arrow" aria-hidden="true">→</span></a></div>
          </li>
        )}
        <li class="b-card b-text reveal">
          <div><p class="chip-status">Free · {skills} skills</p><h3>Claude skills</h3><p class="muted">The skills I use for decks, logos, carousels, thumbnails, video prompts and writing. Copy or download them.</p><a class="btn" href={href('/skills/')}>Get the skills <span class="arrow" aria-hidden="true">→</span></a></div>
        </li>
        <li class="b-card b-text reveal">
          <div><p class="chip-status">Lab · experiment</p><h3>Inkline</h3><p class="muted">A 30-second engraved 3D launch film made from a pasted script.</p><a class="btn" href={href('/lab/inkline/')}>See the experiment <span class="arrow" aria-hidden="true">→</span></a></div>
        </li>
      </ul>
    </div>
  </section>

  <!-- MANTRA -->
  <section class="mantra wrap" aria-label="Motto">
    <p class="reveal">Sketch<span class="a">.</span><wbr />Edit<span class="a">.</span><wbr /><em class="s">Automate</em><span class="b-dot">.</span><wbr />Repeat<span class="a">.</span></p>
  </section>

  <!-- START -->
  <section class="wrap section start" aria-labelledby="start-h">
    <h2 id="start-h" class="h-sec reveal start-h">Starting is <em class="s">simple</em></h2>
    <p class="lede reveal">Send a few lines about what you're making, who it's for and when you need it.</p>
    <p class="start-cta reveal">
      <a class="btn btn-primary" href={`mailto:${P.profile.email}`} data-track="CTA Click" data-track-id="home-talk">Email me <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn" href={P.profile.linkedin} rel="me noopener" data-track="Follow Click" data-track-platform="linkedin">LinkedIn</a>
      <a class="btn" href={P.profile.behance} rel="me noopener">Behance</a>
    </p>
    <p class="stack-type reveal" aria-hidden="true"><span>MAKE</span><span>IT</span><em class="s">by hand</em><span>THEN</span><span>SHIP IT</span></p>
  </section>
</Base>

<script>
  // Reveal on scroll: hidden only once JS is running, so no-JS visitors see everything.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll<HTMLElement>('.reveal');
  if (!reduce && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js-reveal');
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach((el) => io.observe(el));
  }

  // Floating cover preview on the work list (mouse only).
  const list = document.querySelector<HTMLElement>('[data-work]');
  const float = document.querySelector<HTMLImageElement>('.w-float');
  if (list && float && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let x = 0, y = 0, raf = 0;
    const move = () => { raf = 0; float.style.transform = `translate(${x}px, ${y}px)`; };
    list.addEventListener('pointermove', (e) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('.w-row');
      const src = row?.dataset.cover;
      if (src) { if (float.getAttribute('src') !== src) float.src = src; float.hidden = false; } else float.hidden = true;
      x = e.clientX + 24; y = e.clientY - 120;
      if (!raf) raf = requestAnimationFrame(move);
    });
    list.addEventListener('pointerleave', () => (float.hidden = true));
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero { padding-top: var(--space-6); padding-bottom: var(--space-16); }
  .hero-top { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-6); flex-wrap: wrap; }
  .logo { font-size: clamp(3rem, 1.4rem + 7vw, 7.5rem); font-weight: 800; letter-spacing: -0.06em; line-height: 0.9; margin: 0; max-width: none; }
  .logo em { font-size: 1.04em; margin-left: 0.04em; letter-spacing: -0.02em; }
  .hero-meta { display: flex; gap: var(--space-3); align-items: center; font-size: var(--text-sm); line-height: 1.35; margin-top: var(--space-4); }
  .hero-meta p { margin: 0; }
  .avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; filter: grayscale(1); }
  .statement {
    font-size: clamp(2.4rem, 1rem + 5.6vw, 6.25rem); font-weight: 750; letter-spacing: -0.05em; line-height: 0.98;
    margin: clamp(6rem, 18vh, 14rem) 0 0; max-width: 17ch;
  }
  .statement em { font-size: 1.05em; }
  .dim { color: #6f6f75; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; margin-top: var(--space-12); }
  .avail { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--color-text-muted); margin-left: var(--space-2); }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--color-a); box-shadow: 0 0 0 0 rgba(184, 240, 0, 0.6); animation: pulse 2.4s var(--ease-standard) 3; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(184, 240, 0, 0.6); } 100% { box-shadow: 0 0 0 10px rgba(184, 240, 0, 0); } }

  /* ---------- panels ---------- */
  .panel { background: var(--color-panel); border-radius: var(--radius-xl); margin-inline: clamp(0px, 1vw, 12px); padding-block: var(--space-12); }
  .intro-head { display: flex; gap: var(--space-4); align-items: center; }
  .avatar-lg { width: 72px; height: 72px; border-radius: 16px; object-fit: cover; filter: grayscale(1); }
  .intro-name { font-size: var(--text-lg); font-weight: 650; margin: 0; letter-spacing: -0.02em; }
  .intro-roles { margin: 0; font-size: var(--text-lg); letter-spacing: -0.02em; line-height: 1.2; }
  .cards3 { list-style: none; padding: 0; margin: var(--space-12) 0 0; display: grid; gap: var(--space-4); }
  @media (min-width: 56rem) { .cards3 { grid-template-columns: repeat(3, 1fr); } }
  .card3 p { font-size: var(--text-lg); line-height: 1.3; letter-spacing: -0.02em; margin-top: var(--space-4); }
  .vis { aspect-ratio: 1 / 1; border-radius: var(--radius-xl); background: var(--color-surface); overflow: hidden; display: grid; place-items: center; position: relative; }
  .vis-stack { padding: 6%; }
  .vis-stack :global(.cs-legend), .vis-stack :global(.cs-key) { display: none; }
  .vis-stack :global(.cs) { width: 100%; }
  .vis-toggle { background-image: radial-gradient(rgba(242, 243, 245, 0.06) 1px, transparent 1px); background-size: 10px 10px; }
  .tg { display: inline-flex; align-items: center; gap: var(--space-6); padding: 10px 28px 10px 10px; border-radius: 999px; background: #0b0b0c; box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.8), 0 0 0 10px #161618; font-weight: 700; letter-spacing: 0.04em; }
  .tg-knob { padding: 18px 26px; border-radius: 999px; background: linear-gradient(#1f1f22, #0e0e10); box-shadow: 0 2px 0 rgba(255, 255, 255, 0.06) inset, 0 6px 16px rgba(0, 0, 0, 0.6); color: var(--color-a); font-size: 1.1rem; }
  .tg-ai { color: var(--color-b); font-size: 1.1rem; opacity: 0.7; }
  .vis-word { background-image: linear-gradient(rgba(242, 243, 245, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(242, 243, 245, 0.05) 1px, transparent 1px); background-size: 40px 40px; }
  .term { font-family: ui-monospace, Menlo, monospace; font-size: clamp(1rem, 0.8rem + 1vw, 1.5rem); padding: 18px 24px; border-radius: 14px; background: #0b0b0c; border: 1px solid var(--color-line-strong); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5); }
  .caret { display: inline-block; width: 0.55em; height: 1.1em; vertical-align: -0.2em; background: var(--color-a); margin-left: 2px; animation: blink 1s steps(2) 6; }
  @keyframes blink { 50% { opacity: 0; } }

  /* ---------- section heads ---------- */
  .sec-top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-8); }
  .h-sec { font-size: clamp(2.25rem, 1.2rem + 4vw, 5rem); letter-spacing: -0.05em; line-height: 0.95; margin: 0; }
  .h-sec em { font-size: 1.08em; }
  .all { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; font-size: var(--text-sm); font-weight: 600; min-height: 44px; }
  .plus { width: 36px; height: 36px; border-radius: 50%; background: var(--color-text); color: var(--color-bg); display: grid; place-items: center; font-size: 1.25rem; font-weight: 500; transition: transform var(--dur-base) var(--ease-standard), background-color var(--dur-base) var(--ease-standard); }
  @media (hover: hover) { .all:hover .plus { transform: rotate(90deg); background: var(--color-a); } }

  /* ---------- work list ---------- */
  .work { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-line); }
  .w-row { border-bottom: 1px solid var(--color-line); }
  .w-row a {
    display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'n year' 'tags tags' 'title go' 'sum sum' 'thumb thumb';
    gap: var(--space-2) var(--space-4); padding: var(--space-6) 0 var(--space-8); text-decoration: none; position: relative;
  }
  .w-n { grid-area: n; font-size: var(--text-sm); font-variant-numeric: tabular-nums; }
  .w-tags { grid-area: tags; display: flex; gap: var(--space-4); font-size: var(--text-sm); color: var(--color-text-muted); flex-wrap: wrap; }
  .w-year { grid-area: year; font-size: var(--text-sm); text-align: right; }
  .w-title { grid-area: title; font-size: clamp(2.25rem, 1rem + 5vw, 6rem); font-weight: 750; letter-spacing: -0.055em; line-height: 0.95; margin-top: var(--space-6); transition: color var(--dur-base) var(--ease-standard), transform var(--dur-slow) var(--ease-standard); }
  .w-sum { grid-area: sum; max-width: 52ch; font-size: var(--text-sm); }
  .w-go { grid-area: go; align-self: end; font-size: clamp(1.5rem, 1rem + 2vw, 3rem); color: var(--color-text-muted); transition: transform var(--dur-base) var(--ease-standard), color var(--dur-base) var(--ease-standard); }
  .w-thumb { grid-area: thumb; width: 100%; max-height: 18rem; object-fit: cover; border-radius: var(--radius); margin-top: var(--space-3); }
  @media (min-width: 56rem) {
    .w-row a {
      grid-template-columns: 30% 1fr auto auto; grid-template-areas: '. n tags year' '. title title go' '. sum sum .';
      padding: var(--space-6) 0 var(--space-12);
    }
    .w-tags { justify-content: flex-end; }
    .w-thumb { display: none; }
  }
  @media (hover: hover) {
    .w-row a:hover .w-title { color: var(--color-a); transform: translateX(0.12em); }
    .w-row a:hover .w-go { color: var(--color-a); transform: translate(4px, -4px); }
  }
  .w-float { position: fixed; left: 0; top: 0; width: 320px; height: 220px; object-fit: cover; border-radius: var(--radius); pointer-events: none; z-index: 40; box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6); }

  /* ---------- numbers ---------- */
  .stats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8) var(--space-6); }
  @media (min-width: 56rem) { .stats { grid-template-columns: repeat(5, 1fr); } }
  .stats li { display: grid; gap: var(--space-2); border-top: 1px solid var(--color-line); padding-top: var(--space-4); }
  .st-v { font-size: clamp(2.5rem, 1.4rem + 3.6vw, 5rem); font-weight: 800; letter-spacing: -0.06em; line-height: 1; }
  .stats li:nth-child(2) .st-v { color: var(--color-a); }
  .st-l { font-size: var(--text-sm); }

  /* ---------- process ---------- */
  .process { position: relative; overflow: hidden; padding-block: var(--space-16); }
  .mosaic { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(10, 1fr); grid-auto-rows: 1fr; opacity: 0.55; mask-image: linear-gradient(90deg, transparent, #000 55%); -webkit-mask-image: linear-gradient(90deg, transparent, #000 55%); }
  .mosaic i { display: block; }
  .px-0 { background: transparent; } .px-1 { background: #161618; } .px-2 { background: #222226; } .px-a { background: var(--color-a); opacity: 0.85; } .px-b { background: var(--color-b-strong); }
  .proc-inner { position: relative; }
  .steps { list-style: none; padding: 0; margin: var(--space-12) 0 0; display: grid; gap: var(--space-4); }
  @media (min-width: 56rem) { .steps { grid-template-columns: repeat(3, 1fr); } }
  .step { background: rgba(5, 5, 5, 0.88); border: 1px solid var(--color-line); border-radius: var(--radius-xl); padding: var(--space-8); }
  .st-n { font-size: 3rem; color: var(--color-a); line-height: 1; }
  .step h3 { font-size: var(--text-xl); margin: var(--space-4) 0 var(--space-2); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-4) 0 0; }
  .aside { font-size: var(--text-lg); margin-top: var(--space-12); max-width: 40ch; letter-spacing: -0.02em; background: rgba(5, 5, 5, 0.88); padding: var(--space-2) var(--space-3); border-radius: 8px; }
  .paren { font-family: var(--font-serif); color: var(--color-a); font-size: 1.4em; }

  /* ---------- services ---------- */
  .svc { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-line); }
  .svc-row { display: grid; grid-template-columns: 3rem 1fr; gap: var(--space-2) var(--space-4); padding: var(--space-8) 0; border-bottom: 1px solid var(--color-line); }
  .svc-row > :not(.svc-n) { grid-column: 2; }
  .svc-n { color: var(--color-text-muted); font-size: var(--text-sm); padding-top: 0.6em; }
  .svc-row h3 { font-size: clamp(1.75rem, 1.2rem + 2vw, 3rem); letter-spacing: -0.045em; margin: 0; }
  .svc-row p { margin: 0; max-width: 56ch; }
  @media (min-width: 56rem) {
    .svc-row { grid-template-columns: 3rem 1.2fr 1fr; align-items: start; }
