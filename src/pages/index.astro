---
// Personal brand home: Vikas Banjare (light theme).
// Design references, combined: neutomni.com (giant wordmark, one brand colour, mono labels, live local time,
// solid process cards, ticket contact), jlern.com (name-letter grid with drawn icons), extrafazant.nl
// (bold + light display mix, tilted photo and service cards, arrow-box buttons) and anfalova.art
// (numbered project list, italic serif accents). No assets or copy were taken from them.
// Content lives in content/portfolio.json.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import Boot from '../components/Boot.astro';
import { loadContent } from '../lib/content';
import { href } from '../lib/href';

const P = JSON.parse(readFileSync(join(process.cwd(), 'content/portfolio.json'), 'utf8'));
const c = loadContent();
const skills = c.resources.filter((r) => r.type === 'skill').length;
const free = c.resources.length;
const contentintel = c.tools.find((t) => t.slug === 'contentintel');
const captions = c.tools.find((t) => t.slug === 'cutpilot-caption-studio');

// Name grid: letters of VIKAS between small line drawings of the work (24x24 viewBox, stroke = currentColor).
const ICONS: Record<string, { label: string; svg: string; tone: 'a' | 'b' | 'ink' }> = {
  camera: { label: 'Video shoots', tone: 'b', svg: '<rect x="2" y="7" width="14" height="11" rx="2"/><path d="M16 11l6-3v9l-6-3"/><circle cx="7" cy="12.5" r="2"/>' },
  thumb: { label: 'Thumbnails', tone: 'a', svg: '<rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="8" cy="11" r="2.5"/><path d="M13 9h6M13 12h4M4 17l5-4 4 3 3-2 4 3"/>' },
  wave: { label: 'Sound', tone: 'b', svg: '<path d="M2 12h2M6 8v8M9 5v14M12 9v6M15 6v12M18 10v4M21 12h1"/>' },
  timeline: { label: 'Editing', tone: 'ink', svg: '<rect x="2" y="4" width="20" height="5" rx="1"/><rect x="2" y="11" width="12" height="4" rx="1"/><rect x="9" y="17" width="13" height="4" rx="1"/><path d="M15 2v20"/>' },
  pen: { label: 'Design by hand', tone: 'a', svg: '<path d="M4 20l4-1 11-11-3-3L5 16l-1 4z"/><path d="M14 7l3 3"/>' },
  layers: { label: 'Motion', tone: 'b', svg: '<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/><path d="M3 17.5l9 5 9-5" opacity=".5"/>' },
  play: { label: 'Podcasts', tone: 'ink', svg: '<circle cx="12" cy="12" r="9"/><path d="M10 8.5l6 3.5-6 3.5z"/>' },
  slash: { label: 'Free resources', tone: 'a', svg: '<path d="M8 20L16 4"/><path d="M3 12h3M18 12h3"/>' },
  chip: { label: 'AI workflows', tone: 'b', svg: '<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/><path d="M10 13.5l1.2-3.5h1.6l1.2 3.5M10.4 12.5h3.2"/>' },
  heart: { label: 'Storytelling', tone: 'a', svg: '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>' },
};
const GRID: (string | { icon: string })[] = [
  'V', { icon: 'camera' }, { icon: 'thumb' }, 'I', { icon: 'wave' },
  { icon: 'timeline' }, 'K', { icon: 'pen' }, { icon: 'layers' }, 'A',
  { icon: 'play' }, { icon: 'slash' }, 'S', { icon: 'chip' }, { icon: 'heart' },
];

const services = [
  { title: 'Video', sub: 'Shoots, podcasts, trailers, edits', tone: 'svc-b', tilt: '-3deg', icon: 'camera' },
  { title: 'Design', sub: 'Social, thumbnails, emailers, campaigns', tone: 'svc-a', tilt: '2deg', icon: 'thumb' },
  { title: 'UI/UX', sub: 'Flows, landing pages, design systems', tone: 'svc-ink', tilt: '-1.5deg', icon: 'layers' },
  { title: 'AI', sub: 'Workflows, plugins, Claude skills', tone: 'svc-w', tilt: '3deg', icon: 'chip' },
];
const steps = [
  { n: '01', a: 'Brief', b: '& plan', body: 'A short call: what you need, who it is for, where it will run.' },
  { n: '02', a: 'Sketch', b: 'by hand', body: 'Storyboards, layouts and flows before anything is generated.' },
  { n: '03', a: 'Make', b: '& automate', body: 'People make the calls. AI and automation carry the repetitive parts.' },
  { n: '04', a: 'Ship', b: '& grow', body: 'Files, sources and how it was made. Then variants and support.' },
];
---
<Base title="Vikas Banjare" description="Vikas Banjare (Bubu): designer, editor and storyteller. Video, design, UI/UX and AI workflows. Founder of AI-Floh." bare>
  <Boot />
  <!-- HEADER: giant wordmark + meta row -->
  <header class="top">
    <p class="wordmark" aria-label="Vikas Banjare">vikas<em>banjare</em></p>
    <div class="meta wrap">
      <p class="m-role">Designer, editor &amp; storyteller</p>
      <nav class="m-nav" aria-label="Main">
        <a href="#work">Work</a>
        <a href={href('/tools/')}>Tools</a>
        <a href={href('/free/')} class="m-free">Free</a>
        <a href={href('/studio/')}>Studio</a>
        <a href={href('/about/')}>About</a>
      </nav>
      <p class="m-right">
        <a class="m-mail" href={`mailto:${P.profile.email}`}>{P.profile.email}</a>
        <span class="m-time"><span class="dot-live" aria-hidden="true" />{P.profile.availability} · <time data-clock>IST</time></span>
      </p>
    </div>
  </header>

  <!-- HERO -->
  <section class="hero wrap" aria-labelledby="hero-h">
    <p class="kick rise">Video, design <span class="serif">&amp;</span> AI workflows</p>
    <h1 id="hero-h" class="display rise-2">
      <span class="ln"><b>I keep the</b> <span class="lt">craft</span></span>
      <span class="ln"><b>&amp; automate</b> <span class="lt">the grind</span></span>
    </h1>
    <p class="cta rise-3">
      <a class="sq" href="#work"><span class="sq-ico" aria-hidden="true">↓</span><span>See the work</span></a>
      <a class="sq sq-ghost" href={`mailto:${P.profile.email}`} data-track="CTA Click" data-track-id="home-talk"><span class="sq-ico" aria-hidden="true">→</span><span>Start a project</span></a>
    </p>
    <p class="equation rise-3" aria-label="Video plus design plus AI equals the full story">
      <span>VIDEO</span><i>+</i><span>DESIGN</span><i>+</i><span>AI</span><i>=</i><span class="eq-end">THE FULL STORY</span>
    </p>
  </section>

  <!-- NAME GRID -->
  <section class="wrap namegrid-wrap" aria-label="What I do, in pictures">
    <ul class="namegrid" role="list">
      {GRID.map((cell) =>
        typeof cell === 'string' ? (
          <li class="ng ng-letter" aria-hidden="true"><span>{cell}</span></li>
        ) : (
          <li class={`ng ng-icon tone-${ICONS[cell.icon].tone}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[cell.icon].svg} />
            <span class="ng-label">{ICONS[cell.icon].label}</span>
          </li>
        ),
      )}
    </ul>
  </section>

  <!-- INTRO -->
  <section class="wrap section intro" aria-labelledby="intro-h">
    <div class="intro-text reveal">
      <p class="label">About</p>
      <h2 id="intro-h" class="h2">I make work that <span class="hl">moves</span>, converts and gets <em class="s">remembered</em>.</h2>
      <p class="lede">Eight years across video, design, UI/UX and content. These days I also build the tools and Claude skills that take the repetitive parts off the job, under my studio, AI-Floh.</p>
      <p><a class="sq sq-ghost" href={href('/about/')}><span class="sq-ico" aria-hidden="true">→</span><span>More about me</span></a></p>
    </div>
    <figure class="polaroid reveal">
      <img src={href(P.profile.photo)} alt={P.profile.name} width="230" height="230" />
      <figcaption>{P.profile.nickname} · {P.profile.name}</figcaption>
      <span class="sticker" aria-hidden="true">made<br />by hand</span>
    </figure>
  </section>

  <!-- NUMBERS -->
  <section class="wrap numbers" aria-label="In numbers">
    <ul class="stats" role="list">
      {P.stats.map((s: any, i: number) => (
        <li class="reveal"><span class={`st-v ${i === 1 ? 'hl' : ''}`}>{s.value}</span><span class="st-l">{s.label}</span></li>
      ))}
    </ul>
  </section>

  <!-- WORK -->
  <section class="wrap section" id="work" aria-labelledby="work-h">
    <div class="sec-top reveal">
      <h2 id="work-h" class="display-sm"><b>Selected</b> <span class="lt">work</span></h2>
      <a class="sq sq-ghost" href={P.profile.behance} rel="me noopener"><span class="sq-ico" aria-hidden="true">↗</span><span>All on Behance</span></a>
    </div>
    <ol class="work" role="list" data-work>
      {P.projects.map((p: any, i: number) => (
        <li class="w-row reveal" data-cover={p.cover ? href(p.cover) : undefined}>
          <a href={p.link} rel="noopener">
            <span class="w-n">{String(i + 1).padStart(2, '0')}.</span>
            <span class="w-title">{p.title}</span>
            <span class="w-tags">{p.tags.join(', ')}</span>
            <span class="w-year">{p.year}</span>
            <span class="w-go" aria-hidden="true">↗</span>
            {p.cover && <img class="w-thumb" src={href(p.cover)} alt={p.coverAlt} loading="lazy" width="600" height="400" />}
          </a>
        </li>
      ))}
    </ol>
    <img class="w-float" alt="" aria-hidden="true" hidden />
  </section>

  <!-- SERVICES -->
  <section class="section services" aria-labelledby="svc-h">
    <div class="wrap">
      <p class="kick center reveal">What I do</p>
      <h2 id="svc-h" class="display-sm center reveal"><b>Four things,</b> <span class="lt">done well</span></h2>
      <ul class="svc" role="list">
        {services.map((s) => (
          <li class={`svc-card ${s.tone} reveal`} style={`--tilt:${s.tilt}`}>
            <div class="svc-art">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[s.icon].svg} />
            </div>
            <h3>{s.title}</h3>
            <p>{s.sub}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="wrap section" aria-labelledby="proc-h">
    <div class="sec-top reveal">
      <h2 id="proc-h" class="display-sm"><b>How it</b> <span class="lt">works</span></h2>
      <p class="label">A <span aria-hidden="true">→</span> B, without extra steps</p>
    </div>
    <ol class="steps" role="list">
      {steps.map((s) => (
        <li class="step reveal">
          <span class="step-n">{s.n}</span>
          <h3>{s.a} <em>{s.b}</em></h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- BUILT -->
  <section class="wrap section" aria-labelledby="built-h">
    <div class="sec-top reveal">
      <h2 id="built-h" class="display-sm"><b>Things I</b> <span class="lt">built</span></h2>
      <a class="sq sq-ghost" href={href('/tools/')}><span class="sq-ico" aria-hidden="true">→</span><span>All tools</span></a>
    </div>
    <ul class="built" role="list">
      {contentintel && (
        <li class="win win-big reveal">
          <p class="win-bar"><span>contentintel.in</span><span class="chip">Live</span></p>
          <img src={href('/media/portfolio/contentintel-site.webp')} alt="The ContentIntel website" width="900" height="1347" loading="lazy" />
          <div class="win-body"><h3>{contentintel.title}</h3><p>{contentintel.summary}</p><a class="link" href={href('/tools/contentintel/')}>About the tool →</a></div>
        </li>
      )}
      {captions && (
        <li class="win reveal">
          <p class="win-bar"><span>caption-studio.web</span><span class="chip chip-b">Beta</span></p>
          <div class="win-body"><h3>{captions.title}</h3><p>{captions.summary}</p><a class="link" href={href('/tools/cutpilot-caption-studio/')}>About the tool →</a></div>
        </li>
      )}
      <li class="win reveal">
        <p class="win-bar"><span>skills.zip</span><span class="chip">Free · {skills}</span></p>
        <div class="win-body"><h3>Claude skills</h3><p>The skills I use for decks, logos, carousels, thumbnails, video prompts and writing.</p><a class="link" href={href('/skills/')}>Get the skills →</a></div>
      </li>
      <li class="win reveal">
        <p class="win-bar"><span>inkline.mp4</span><span class="chip chip-b">Lab</span></p>
        <div class="win-body"><h3>Inkline</h3><p>A 30-second engraved 3D launch film made from a pasted script.</p><a class="link" href={href('/lab/inkline/')}>See the experiment →</a></div>
      </li>
    </ul>
  </section>

  <!-- FREE STRIP -->
  <section class="wrap free-strip reveal" aria-labelledby="free-h">
    <div>
      <h2 id="free-h" class="display-sm"><b>{free} free</b> <span class="lt">things</span></h2>
      <p>Every post ends with a word. Type it here and get the prompt, skill or template.</p>
    </div>
    <a class="sq" href={href('/free/')}><span class="sq-ico" aria-hidden="true">→</span><span>Open the free list</span></a>
  </section>

  <!-- TICKET -->
  <section class="wrap section" aria-labelledby="ticket-h">
    <div class="ticket reveal">
      <div class="t-main">
        <p class="label">Contact</p>
        <h2 id="ticket-h" class="display-sm"><b>Ready to make</b> <span class="lt">something?</span></h2>
        <p>Treat it like a first chat. A few lines about what you're making, who it's for and when you need it.</p>
        <p class="t-cta">
          <a class="sq" href={`mailto:${P.profile.email}`} data-track="CTA Click" data-track-id="home-talk"><span class="sq-ico" aria-hidden="true">→</span><span>Email me</span></a>
          <a class="sq sq-ghost" href={P.profile.linkedin} rel="me noopener" data-track="Follow Click" data-track-platform="linkedin"><span class="sq-ico" aria-hidden="true">in</span><span>LinkedIn</span></a>
        </p>
      </div>
      <div class="t-stub" aria-hidden="true">
        <p class="mono">VB / 2026</p>
        <p class="t-big">✂</p>
        <p class="mono">Open for work</p>
        <p class="mono"><time data-clock>IST</time></p>
        <p class="mono small">Made by hand · sped up by AI</p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Live local time (India). Display only; nothing stored.
  const clocks = document.querySelectorAll<HTMLElement>('[data-clock]');
  const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata', hour12: false });
  const tick = () => clocks.forEach((el) => (el.textContent = `${fmt.format(new Date())} IST`));
  tick();
  setInterval(tick, 30000);

  // Reveal on scroll: hidden only once JS runs, so no-JS visitors see everything.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js-reveal');
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  }

  // Floating cover preview on the work list (mouse only).
  const list = document.querySelector<HTMLElement>('[data-work]');
  const float = document.querySelector<HTMLImageElement>('.w-float');
  if (list && float && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let x = 0, y = 0, raf = 0;
    const move = () => { raf = 0; float.style.transform = `translate(${x}px, ${y}px) rotate(-3deg)`; };
    list.addEventListener('pointermove', (e) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('.w-row');
      const src = row?.dataset.cover;
      if (src) { if (float.getAttribute('src') !== src) float.src = src; float.hidden = false; } else float.hidden = true;
      x = e.clientX + 24; y = e.clientY - 140;
      if (!raf) raf = requestAnimationFrame(move);
    });
    list.addEventListener('pointerleave', () => (float.hidden = true));
  }
</script>

<style>
  /* ---------- header ---------- */
  .top { padding-top: var(--space-4); border-bottom: 1px solid var(--color-text); }
  .wordmark {
    margin: 0; max-width: none; padding-inline: clamp(8px, 1.2vw, 20px); white-space: nowrap; overflow: hidden;
    font-size: 19.6vw; font-weight: 850; letter-spacing: -0.07em; line-height: 0.82; color: var(--color-text);
  }
  .wordmark em { font-family: var(--font-serif); font-weight: 400; letter-spacing: -0.04em; color: var(--color-b); }
  .meta { display: grid; grid-template-columns: 1fr; gap: var(--space-2); padding-block: var(--space-3) var(--space-4); font-size: var(--text-sm); align-items: center; }
  .meta p { margin: 0; max-width: none; }
  .m-nav { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
  .m-nav a { text-decoration: none; min-height: 32px; display: inline-flex; align-items: center; }
  .m-nav a:hover { color: var(--color-b); }
  .m-free { background: var(--color-a-fill); padding-inline: var(--space-2); border: 1px solid var(--color-text); font-weight: 700; }
  .m-right { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); align-items: center; }
  .m-mail { font-family: var(--font-serif); font-style: italic; font-size: 1.1em; color: var(--color-b); }
  .m-time { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .dot-live { width: 8px; height: 8px; border-radius: 50%; background: var(--color-a-fill); box-shadow: 0 0 0 1px var(--color-text); }
  @media (min-width: 56rem) {
    .meta { grid-template-columns: 1fr auto 1fr; }
    .m-nav { justify-content: center; }
    .m-right { justify-content: flex-end; }
  }

  /* ---------- display type: bold sans + light serif ---------- */
  .display, .display-sm { font-weight: 400; letter-spacing: -0.04em; line-height: 0.9; margin: 0; text-transform: uppercase; }
  .display b, .display-sm b { font-weight: 850; letter-spacing: -0.055em; }
  .display .lt, .display-sm .lt { font-family: var(--font-serif); font-weight: 400; letter-spacing: -0.02em; text-transform: none; font-style: italic; color: var(--color-b); }
  .display { font-size: clamp(2.6rem, 0.6rem + 8.4vw, 9.5rem); text-align: center; }
  .display .ln { display: block; }
  .display-sm { font-size: clamp(2.2rem, 1rem + 4.4vw, 5.25rem); }
  .center { text-align: center; }
  .kick { font-family: var(--font-serif); font-size: clamp(1.3rem, 1rem + 1vw, 2rem); text-align: center; margin: 0 auto var(--space-4); letter-spacing: -0.01em; }
  .kick .serif { font-style: italic; color: var(--color-b); }
  .label { font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); margin: 0 0 var(--space-3); }

  /* ---------- hero ---------- */
  .hero { padding-block: clamp(3rem, 8vh, 6rem) var(--space-12); text-align: center; }
  .cta { display: flex; justify-content: center; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-12) auto 0; }
  .equation { display: flex; justify-content: center; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin: var(--space-12) auto 0; max-width: none; font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: var(--text-xs); letter-spacing: 0.12em; }
  .equation i { font-style: normal; color: var(--color-b); }
  .eq-end { background: var(--color-a-fill); padding-inline: 0.4em; }

  /* square arrow-box buttons */
  .sq { display: inline-flex; align-items: stretch; min-height: 48px; text-decoration: none; font-weight: 750; font-size: var(--text-sm); text-transform: uppercase; letter-spacing: 0.02em; border: 1.5px solid var(--color-text); background: var(--color-text); color: var(--color-bg); }
  .sq > span:last-child { display: inline-flex; align-items: center; padding: 0 var(--space-4); }
  .sq-ico { display: inline-grid; place-items: center; width: 48px; background: var(--color-a-fill); color: var(--color-a-ink); border-right: 1.5px solid var(--color-text); font-size: 1.1rem; transition: transform var(--dur-base) var(--ease-standard); }
  .sq-ghost { background: var(--color-surface); color: var(--color-text); }
  @media (hover: hover) {
    .sq:hover .sq-ico { transform: translateX(3px); }
    .sq:hover { box-shadow: 4px 4px 0 var(--color-b); }
  }
  .sq { transition: box-shadow var(--dur-base) var(--ease-standard); }

  /* ---------- name grid ---------- */
  .namegrid-wrap { padding-block: var(--space-8) var(--space-16); }
  .namegrid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--color-line); border-left: 1px solid var(--color-line); }
  @media (min-width: 48rem) { .namegrid { grid-template-columns: repeat(5, 1fr); } }
  .ng { aspect-ratio: 1; border-right: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); display: grid; place-items: center; position: relative; background: var(--color-surface); overflow: hidden; }
  .ng-letter span { font-family: var(--font-serif); font-size: clamp(3rem, 2rem + 5vw, 7.5rem); line-height: 1; }
  .ng-icon svg { width: 46%; height: 46%; transition: transform var(--dur-slow) var(--ease-standard); }
  .tone-a svg { color: var(--color-text); fill: var(--color-a-fill); fill-opacity: 0.9; }
  .tone-b svg { color: var(--color-b); fill: var(--color-b-soft); }
  .tone-ink svg { color: var(--color-text); }
  .ng-label { position: absolute; left: 0; right: 0; bottom: 8px; text-align: center; font-family: ui-monospace, Menlo, monospace; font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-text-muted); }
  @media (hover: hover) { .ng-icon:hover svg { transform: rotate(-8deg) scale(1.12); } .ng-icon:hover { background: var(--color-bg); } }

  /* ---------- intro ---------- */
  .intro { display: grid; gap: var(--space-12); align-items: center; }
