---
import { safeJson } from '../lib/json';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { href } from '../lib/href';
import { SITE_NAME, ANALYTICS_TOOL, ANALYTICS_SRC, ANALYTICS_DOMAIN, BEHANCE_URL, GITHUB_URL, SOCIALS } from '../lib/config';
const LINKEDIN_URL = SOCIALS.find((s) => s.platform === 'linkedin')?.url;
import { loadContent } from '../lib/content';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string; // site-absolute path, e.g. /og/my-slug.png
  bare?: boolean; // page draws its own header (home)
  intro?: boolean; // page shows the Boot intro
}
const { title, description, noindex = false, ogImage, bare = false, intro = false } = Astro.props;

const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const current = '/' + Astro.url.pathname.slice(import.meta.env.BASE_URL.length).replace(/\/$/, '');
const og = new URL(href(ogImage ?? '/og/site.png'), Astro.site).toString();

const c = loadContent();
const slugs = [...c.resources, ...c.tools, ...c.experiments, ...c.work, ...c.repos].map((i) => i.slug);
const intents = [...new Set(c.resources.map((r) => r.intent))];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': '#org', name: SITE_NAME, url: new URL(href('/'), Astro.site).toString(), founder: { '@id': '#vikas' } },
    {
      '@type': 'Person', '@id': '#vikas', name: 'Vikas Banjare', alternateName: 'Bubu',
      jobTitle: 'Designer, video editor and storyteller', url: new URL(href('/about/'), Astro.site).toString(),
      sameAs: [LINKEDIN_URL, BEHANCE_URL, GITHUB_URL].filter(Boolean),
    },
    { '@type': 'WebSite', name: SITE_NAME, url: new URL(href('/'), Astro.site).toString() },
  ],
};
const analyticsOn = ANALYTICS_TOOL !== 'none' && !!ANALYTICS_SRC && !!ANALYTICS_DOMAIN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="theme-color" content="#f3f1ea" />
    <link rel="preload" href={href('/fonts/inter-latin-opsz.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    <script type="application/ld+json" set:html={safeJson(jsonLd)} />
    <script is:inline>
      // Strip every query parameter except the four utm_* ones before analytics loads (Section 13).
      (function () {
        try {
          var u = new URL(location.href), keep = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'], changed = false;
          Array.from(u.searchParams.keys()).forEach(function (k) { if (keep.indexOf(k) < 0) { u.searchParams.delete(k); changed = true; } });
          if (changed) history.replaceState(history.state, '', u.pathname + (u.searchParams.toString() ? '?' + u.searchParams : '') + u.hash);
        } catch (e) {}
      })();
    </script>
    {
      intro && (
        <script is:inline>
          // Decide before first paint whether the intro runs, so it never flashes for people who opted out.
          (function () {
            try {
              if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
              var d = document.documentElement;
              d.classList.add('booting');
              // Fail-safe: whatever happens to the intro script, the page is never held for more than 3.5 s.
              setTimeout(function () { d.classList.remove('booting'); }, 3500);
            } catch (e) {}
          })();
        </script>
      )
    }
    {
      analyticsOn && ANALYTICS_TOOL === 'plausible' && (
        <script is:inline defer data-domain={ANALYTICS_DOMAIN} src={ANALYTICS_SRC} />
      )
    }
    {
      analyticsOn && ANALYTICS_TOOL === 'umami' && (
        <script is:inline defer data-website-id={ANALYTICS_DOMAIN} data-exclude-hash="true" data-exclude-search="false" src={ANALYTICS_SRC} />
      )
    }
    <script type="application/json" id="track-slugs" set:html={safeJson(slugs)} />
    <script type="application/json" id="track-intents" set:html={safeJson(intents)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && <Nav current={current === '/' ? '/' : current} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/track.ts';
    </script>
  </body>
</html>
